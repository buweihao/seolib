---
import type { AboutAdvantagesSectionContent, AboutAdvantageIcon } from "../../content-models/sections";

interface Props extends AboutAdvantagesSectionContent {
  id: string;
  class?: string;
}

const { id, eyebrow, title, items, class: className } = Astro.props;
const renderIcon = (icon: AboutAdvantageIcon) => icon;
---

<section id={id} class:list={["about-advantages", className]} aria-labelledby={`${id}-title`}>
  <div class="about-advantages__decor" aria-hidden="true">
    <span></span><i></i>
    <b></b>
  </div>
  <div class="about-advantages__container">
    <header class="about-advantages__header">
      {eyebrow && <p>{eyebrow}</p>}
      <h2 id={`${id}-title`}>{title}</h2>
      <div class="about-advantages__rule" aria-hidden="true">
        <span></span><i></i><i></i><i></i><span></span>
      </div>
    </header>

    <div class="about-advantages__grid">
      {items.map((item, index) => (
        <article class:list={{ "about-advantages__card--wide": index > 2 }}>
          <div class="about-advantages__icon" aria-hidden="true">
            {renderIcon(item.icon) === "certification" && <svg viewBox="0 0 24 24"><path d="M12 3.5c1.3 0 2.1 1.1 3.2 1.5 1.1.5 2.4.2 3.2 1.2.8 1 .4 2.3.9 3.5.4 1.1 1.5 1.9 1.5 3.2s-1.1 2.1-1.5 3.2c-.5 1.1-.1 2.5-.9 3.5-.8 1-2.1.7-3.2 1.2-1.1.4-1.9 1.5-3.2 1.5s-2.1-1.1-3.2-1.5c-1.1-.5-2.4-.2-3.2-1.2-.8-1-.4-2.3-.9-3.5C4.1 17.1 3 16.3 3 15s1.1-2.1 1.5-3.2c.5-1.1.1-2.5.9-3.5.8-1 2.1-.7 3.2-1.2 1.1-.4 1.9-1.5 3.2-1.5Z" /><path d="m8.5 12 2.2 2.2 4.8-5" /></svg>}
            {renderIcon(item.icon) === "production" && <svg viewBox="0 0 24 24"><path d="M9 4h6M12 4v3M7 8h10a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-6a2 2 0 0 1 2-2ZM5 12H2M22 12h-3M10 12v2M14 12v2M9 18v2M15 18v2" /></svg>}
            {renderIcon(item.icon) === "research" && <svg viewBox="0 0 24 24"><path d="M9 3h6M10 3v6l-5 9a2 2 0 0 0 1.8 3h10.4A2 2 0 0 0 19 18l-5-9V3" /><path d="M7 16h10" /></svg>}
            {renderIcon(item.icon) === "service" && <svg viewBox="0 0 24 24"><path d="m3 11 4-4 4 3 2-2 4 3 4-2v6l-4 4-3-2-1 1a2 2 0 0 1-2.8 0L7 15l-2 1-2-2Z" /><path d="m9 13 3 3M12 11l3 3" /></svg>}
            {renderIcon(item.icon) === "sustainability" && <svg viewBox="0 0 24 24"><path d="M12 3 19 6v5c0 4.6-2.9 8.1-7 10-4.1-1.9-7-5.4-7-10V6l7-3Z" /><path d="m8.5 12 2.2 2.2 4.8-5" /></svg>}
          </div>
          <h3>{item.title}</h3>
          <p>{item.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .about-advantages { position: relative; isolation: isolate; overflow: hidden; background: #2457a6; padding: clamp(4rem, 8vw, 6rem) 0; color: #fff; }
  .about-advantages__decor { position: absolute; z-index: -1; inset: 0; opacity: .22; }
  .about-advantages__decor span, .about-advantages__decor i { position: absolute; width: 32rem; height: 32rem; border: 4rem solid rgb(255 255 255 / .14); border-radius: 50%; }
  .about-advantages__decor span { top: -10rem; right: -8rem; }
  .about-advantages__decor i { bottom: -18rem; left: -9rem; width: 36rem; height: 36rem; border-width: 5rem; }
  .about-advantages__decor b { position: absolute; inset: 0; background-image: linear-gradient(rgb(255 255 255 / .09) 1px, transparent 1px), linear-gradient(90deg, rgb(255 255 255 / .09) 1px, transparent 1px); background-size: 4.5rem 4.5rem; mask-image: linear-gradient(to bottom, transparent, #000 20%, #000 85%, transparent); }
  .about-advantages__container { width: min(100% - 2 * var(--ds-page-gutter), 72rem); margin-inline: auto; }
  .about-advantages__header { margin: 0 auto clamp(2.75rem, 6vw, 4rem); text-align: center; }
  .about-advantages__header p { margin: 0; color: rgb(255 255 255 / .48); font-size: .75rem; font-weight: 800; letter-spacing: .34em; text-transform: uppercase; }
  .about-advantages h2 { margin: .35rem 0 0; font-family: Georgia, "Times New Roman", serif; font-size: clamp(2.1rem, 5vw, 3.55rem); line-height: 1.05; }
  .about-advantages__rule { display: flex; max-width: 26rem; align-items: center; gap: .45rem; margin: 1.25rem auto 0; }
  .about-advantages__rule span { height: 1px; flex: 1; background: rgb(255 255 255 / .7); }
  .about-advantages__rule i { width: .42rem; height: .42rem; border-radius: 999px; background: #fff; }
  .about-advantages__grid { display: grid; gap: 1.5rem; }
  .about-advantages__grid article { display: flex; min-height: 24rem; flex-direction: column; align-items: center; padding: 2.75rem 1.5rem; background: #fff; color: #0f172a; text-align: center; box-shadow: 0 1rem 2rem rgb(10 36 82 / .16); }
  .about-advantages__icon { display: grid; width: 5rem; height: 5rem; place-items: center; color: #2457a6; }
  .about-advantages__icon svg { width: 4.5rem; height: 4.5rem; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.35; }
  .about-advantages h3 { display: flex; width: min(100%, 27rem); min-height: 3rem; align-items: center; justify-content: center; margin: 2rem 0 0; border-radius: 999px; padding: .55rem 1.1rem; background: #2457a6; color: #fff; font-size: .9rem; font-weight: 900; line-height: 1.2; text-transform: uppercase; }
  .about-advantages__grid article > p { margin: 1.65rem 0 0; color: #475569; font-size: .9rem; line-height: 1.6; }
  @media (min-width: 48rem) { .about-advantages__grid { grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 1.5rem; } .about-advantages__grid article { grid-column: span 2; } .about-advantages__grid article.about-advantages__card--wide:nth-child(4) { grid-column: 2 / span 2; } .about-advantages__grid article.about-advantages__card--wide:nth-child(5) { grid-column: 4 / span 2; } }
  @media (min-width: 64rem) { .about-advantages__grid { gap: 1.75rem; } .about-advantages__grid article.about-advantages__card--wide { min-height: 22rem; } }
</style>
