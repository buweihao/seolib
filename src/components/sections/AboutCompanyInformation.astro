---
import type { AboutCompanyInformationContent } from "../../content-models/sections";

interface Props extends AboutCompanyInformationContent {
  id: string;
  class?: string;
}

const { id, eyebrow, title, description, videoUrl, videoAlt, stats, images, class: className } = Astro.props;
const headingId = id + "-title";
const safeImages = images ?? [];
const placeholder = "Add this asset in Sanity";
---

<section id={id} class:list={["about-company-information", className]} aria-labelledby={headingId}>
  <div class="about-company-information__container">
    <header class="about-company-information__header">
      {eyebrow && <p>{eyebrow}</p>}
      <h1 id={headingId}>{title}</h1>
      <div class="about-company-information__rule" aria-hidden="true">
        <span></span><i></i><i></i><i></i><span></span>
      </div>
    </header>

    <div class="about-company-information__feature">
      <div class="about-company-information__video">
        {videoUrl ? (
          <video controls preload="metadata" playsinline aria-label={videoAlt}>
            <source src={videoUrl} />
          </video>
        ) : (
          <div class="about-company-information__placeholder">
            <span class="about-company-information__play" aria-hidden="true">▶</span>
            <span>{placeholder}</span>
          </div>
        )}
      </div>

      <aside class="about-company-information__stats" aria-label="Company statistics">
        {stats.map((stat) => (
          <div>
            <p class="about-company-information__stat-value">
              {stat.value} {stat.unit && <span>{stat.unit}</span>}
            </p>
            <ul>
              {stat.lines.map((line) => <li><span aria-hidden="true">•</span>{line}</li>)}
            </ul>
          </div>
        ))}
      </aside>
    </div>

    <div class="about-company-information__details">
      <div class="about-company-information__details-main">
        <div class="about-company-information__description">
          <h2>About Company</h2>
          <span class="about-company-information__underline" aria-hidden="true"></span>
          <p>{description || placeholder}</p>
        </div>
        <div class="about-company-information__image-column about-company-information__image-column--large">
          {safeImages[2] ? (
            <img src={safeImages[2].src} srcset={safeImages[2].srcset} sizes="(min-width: 64rem) 66vw, 100vw" alt={safeImages[2].alt} width={safeImages[2].width} height={safeImages[2].height} loading="lazy" decoding="async" />
          ) : (
            <div class="about-company-information__image-placeholder">{placeholder}</div>
          )}
        </div>
      </div>
      <div class="about-company-information__image-column">
          {[0, 1, 3].map((index) => (
            safeImages[index] ? (
              <img src={safeImages[index].src} srcset={safeImages[index].srcset} sizes="(min-width: 64rem) 30vw, 100vw" alt={safeImages[index].alt} width={safeImages[index].width} height={safeImages[index].height} loading="lazy" decoding="async" />
            ) : (
              <div class="about-company-information__image-placeholder">{placeholder}</div>
            )
          ))}
      </div>
    </div>
  </div>
</section>

<style>
  .about-company-information { background: #fff; padding: clamp(3.5rem, 7vw, 5rem) 0; }
  .about-company-information__container { width: min(100% - 2 * var(--ds-page-gutter), 72rem); margin-inline: auto; }
  .about-company-information__header { margin: 0 auto clamp(2.75rem, 6vw, 4rem); text-align: center; }
  .about-company-information__header p { margin: 0; color: color-mix(in oklch, var(--ds-color-accent), transparent 58%); font-size: .75rem; font-weight: 800; letter-spacing: .34em; text-transform: uppercase; }
  .about-company-information h1 { margin: .35rem 0 0; color: #17488d; font-family: Georgia, "Times New Roman", serif; font-size: clamp(2.1rem, 5vw, 3.55rem); line-height: 1.05; }
  .about-company-information__rule { display: flex; max-width: 26rem; align-items: center; gap: .45rem; margin: 1.25rem auto 0; color: var(--ds-color-accent); }
  .about-company-information__rule span { height: 1px; flex: 1; background: color-mix(in oklch, var(--ds-color-accent), transparent 52%); }
  .about-company-information__rule i { width: .42rem; height: .42rem; border-radius: 999px; background: var(--ds-color-accent); }
  .about-company-information__feature { display: grid; overflow: hidden; }
  .about-company-information__video { min-height: 16rem; background: #a9bfdc; }
  .about-company-information__video video { display: block; width: 100%; height: 100%; min-height: 16rem; object-fit: cover; }
  .about-company-information__placeholder { display: grid; min-height: 16rem; place-content: center; gap: .75rem; padding: 2rem; color: rgb(255 255 255 / .9); font-size: .8rem; font-weight: 750; text-align: center; }
  .about-company-information__play { font-size: 2.5rem; }
  .about-company-information__stats { display: grid; gap: 1.75rem; align-content: center; padding: 2rem; background: #2457a6; color: #fff; }
  .about-company-information__stats p, .about-company-information__stats ul { margin: 0; }
  .about-company-information__stat-value { font-size: clamp(1.55rem, 3vw, 2rem); font-weight: 900; line-height: 1; }
  .about-company-information__stat-value span { font-size: .75rem; font-weight: 750; }
  .about-company-information__stats ul { display: grid; gap: .25rem; margin-top: .55rem; padding: 0; list-style: none; color: rgb(255 255 255 / .9); font-size: .8rem; line-height: 1.35; }
  .about-company-information__stats li { display: flex; gap: .5rem; }
  .about-company-information__details { display: grid; gap: 2rem; margin-top: 2rem; }
  .about-company-information__description h2 { margin: 0; color: #101828; font-size: clamp(1.65rem, 3vw, 2.2rem); line-height: 1.1; }
  .about-company-information__description p { margin: 1.35rem 0 0; white-space: pre-line; color: #475569; font-size: 1rem; line-height: 2; }
  .about-company-information__underline { display: block; width: 3.5rem; height: .25rem; margin-top: 1rem; background: #101828; }
  .about-company-information__details-main { display: grid; gap: 2rem; align-content: start; }
  .about-company-information__image-column { display: grid; align-content: start; gap: 1.25rem; min-width: 0; }
  .about-company-information__details-main img, .about-company-information__details > .about-company-information__image-column img { display: block; width: 100%; height: auto; background: #edf3fb; }
  .about-company-information__image-placeholder { display: grid; min-height: 10rem; place-items: center; background: #f1f5f9; color: #94a3b8; font-size: .75rem; font-weight: 750; text-align: center; }
  @media (min-width: 48rem) {
    .about-company-information__feature { grid-template-columns: 2fr 1fr; }
    .about-company-information__video { min-height: 24rem; }
    .about-company-information__video video, .about-company-information__placeholder { min-height: 24rem; }
    .about-company-information__stats { padding: 2.25rem; }
    .about-company-information__details { grid-template-columns: minmax(0, 1.65fr) minmax(14rem, .8fr); gap: 2.5rem; }
    .about-company-information__details-main { gap: 2rem; }
  }
  @media (min-width: 64rem) {
    .about-company-information__details { gap: 3rem; }
  }
</style>
