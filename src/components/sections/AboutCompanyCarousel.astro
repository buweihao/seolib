---
import type { AboutCompanyCarouselContent } from "../../content-models/sections";

interface Props extends AboutCompanyCarouselContent {
  id: string;
  class?: string;
}

const { id, eyebrow, title, subtitle, images, class: className } = Astro.props;
---

{images.length > 0 && (
  <section id={id} class:list={["about-company-carousel", className]} aria-labelledby={`${id}-title`}>
    <div class="about-company-carousel__container">
      <header class="about-company-carousel__header">
        {eyebrow && <p>{eyebrow}</p>}
        <h2 id={`${id}-title`}>{title}</h2>
        <div class="about-company-carousel__rule" aria-hidden="true">
          <span></span><i></i><i></i><i></i><span></span>
        </div>
        {subtitle && <p class="about-company-carousel__subtitle">{subtitle}</p>}
      </header>

      <div class="about-company-carousel__viewport" data-about-carousel data-autoplay-ms="3000">
        <div class="about-company-carousel__track" data-about-carousel-track tabindex="0" aria-label="Company showcase images">
          {images.map((image) => (
            <figure>
              <img src={image.src} srcset={image.srcset} sizes="(max-width: 40rem) 88vw, (max-width: 64rem) 50vw, 25vw" alt={image.alt} width={image.width} height={image.height} loading="lazy" decoding="async" />
            </figure>
          ))}
        </div>
        {images.length > 1 && (
          <div class="about-company-carousel__controls">
            <button type="button" data-about-carousel-prev aria-label="Previous company image">←</button>
            <button type="button" data-about-carousel-next aria-label="Next company image">→</button>
          </div>
        )}
      </div>
    </div>
  </section>
)}

<script>
  const imagesCount = (carousel: HTMLElement) => carousel.querySelectorAll("figure").length;

  const initAboutCarousels = () => {
    document.querySelectorAll<HTMLElement>("[data-about-carousel]:not([data-initialized])").forEach((carousel) => {
      const track = carousel.querySelector<HTMLElement>("[data-about-carousel-track]");
      const previous = carousel.querySelector<HTMLButtonElement>("[data-about-carousel-prev]");
      const next = carousel.querySelector<HTMLButtonElement>("[data-about-carousel-next]");
      if (!track) return;

      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const move = (direction: number) => track.scrollBy({ left: direction * Math.max(track.clientWidth * 0.82, 260), behavior: reducedMotion ? "auto" : "smooth" });
      previous?.addEventListener("click", () => move(-1));
      next?.addEventListener("click", () => move(1));
      carousel.dataset.initialized = "true";

      let timer: number | undefined;
      const stop = () => { if (timer) { window.clearInterval(timer); timer = undefined; } };
      const start = () => {
        if (reducedMotion || !next || imagesCount(carousel) < 2) return;
        stop();
        timer = window.setInterval(() => move(1), Number(carousel.dataset.autoplayMs) || 3000);
      };
      carousel.addEventListener("mouseenter", stop);
      carousel.addEventListener("mouseleave", start);
      carousel.addEventListener("focusin", stop);
      carousel.addEventListener("focusout", (event) => { if (!carousel.contains(event.relatedTarget as Node | null)) start(); });
      start();
    });
  };

  initAboutCarousels();
  document.addEventListener("astro:page-load", initAboutCarousels);
</script>

<style>
  .about-company-carousel { overflow: hidden; background: #fff; padding: clamp(3.5rem, 7vw, 5rem) 0; }
  .about-company-carousel__container { width: min(100% - 2 * var(--ds-page-gutter), 80rem); margin-inline: auto; }
  .about-company-carousel__header { margin: 0 auto clamp(2.5rem, 5vw, 3.5rem); text-align: center; }
  .about-company-carousel__header > p:first-child { margin: 0; color: color-mix(in oklch, var(--ds-color-accent), transparent 58%); font-size: .75rem; font-weight: 800; letter-spacing: .34em; text-transform: uppercase; }
  .about-company-carousel h2 { margin: .35rem 0 0; color: #17488d; font-family: Georgia, "Times New Roman", serif; font-size: clamp(2.1rem, 5vw, 3.55rem); line-height: 1.05; text-transform: uppercase; }
  .about-company-carousel__rule { display: flex; max-width: 26rem; align-items: center; gap: .45rem; margin: 1.25rem auto 0; color: var(--ds-color-accent); }
  .about-company-carousel__rule span { height: 1px; flex: 1; background: color-mix(in oklch, var(--ds-color-accent), transparent 52%); }
  .about-company-carousel__rule i { width: .42rem; height: .42rem; border-radius: 999px; background: var(--ds-color-accent); }
  .about-company-carousel__subtitle { max-width: 44rem; margin: 1.25rem auto 0; color: #475569; font-size: .95rem; line-height: 1.6; }
  .about-company-carousel__viewport { position: relative; }
  .about-company-carousel__track { display: grid; grid-auto-columns: 88%; grid-auto-flow: column; gap: 1rem; overflow-x: auto; padding: .25rem .1rem 1rem; scroll-snap-type: x mandatory; scrollbar-width: thin; }
  .about-company-carousel figure { min-width: 0; margin: 0; overflow: hidden; background: #edf3fb; scroll-snap-align: start; }
  .about-company-carousel figure img { display: block; width: 100%; height: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .about-company-carousel__controls { display: flex; justify-content: space-between; pointer-events: none; }
  .about-company-carousel__controls button { display: grid; width: 2.75rem; height: 2.75rem; place-items: center; border: 0; border-radius: 999px; background: rgb(255 255 255 / .92); color: var(--ds-color-accent); font-size: 1.35rem; box-shadow: 0 .5rem 1.2rem rgb(15 23 42 / .16); cursor: pointer; pointer-events: auto; }
  .about-company-carousel__controls button:first-child { margin-left: .5rem; }
  .about-company-carousel__controls button:last-child { margin-right: .5rem; }
  @media (min-width: 40rem) { .about-company-carousel__track { grid-auto-columns: calc(50% - .5rem); gap: 1.25rem; } .about-company-carousel__controls { position: absolute; inset: 50% 0 auto; transform: translateY(-50%); } }
  @media (min-width: 64rem) { .about-company-carousel__track { grid-auto-columns: calc(25% - 1.05rem); gap: 1.4rem; } }
</style>
