---
import Container from "../primitives/Container.astro";
import SectionHeading from "../primitives/SectionHeading.astro";

interface Step { title: string; description: string; action?: string; }
interface Props { id: string; eyebrow?: string; title: string; description?: string; steps: readonly Step[]; class?: string; }
const { id, eyebrow, title, description, steps, class: className } = Astro.props;
const headingId = `${id}-title`;
---

<section id={id} class:list={["sampling-workflow", className]} aria-labelledby={headingId}>
  <Container size="wide">
    <SectionHeading id={headingId} eyebrow={eyebrow} title={title} description={description} />
    <ol class="sampling-workflow__grid">
      {steps.map((step, index) => (
        <li>
          <article>
            <span class="sampling-workflow__number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
            <h3>{step.title}</h3>
            <p>{step.description}</p>
            {step.action && <div class="sampling-workflow__action">{step.action}</div>}
          </article>
        </li>
      ))}
    </ol>
  </Container>
</section>

<style>
  .sampling-workflow { padding-block: var(--ds-section-standard); }
  .sampling-workflow__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); gap: var(--ds-space-4); margin: var(--ds-space-12) 0 0; padding: 0; list-style: none; counter-reset: workflow; }
  .sampling-workflow li { min-width: 0; }
  .sampling-workflow article { height: 100%; padding: var(--ds-space-6); border: 1px solid var(--ds-color-border); background: var(--ds-color-surface); }
  .sampling-workflow__number { display: block; color: var(--ds-color-accent); font-size: .75rem; font-weight: 750; letter-spacing: .1em; }
  .sampling-workflow h3, .sampling-workflow p { margin: 0; }
  .sampling-workflow h3 { margin-top: var(--ds-space-8); font-size: 1.25rem; line-height: 1.2; }
  .sampling-workflow p { margin-top: var(--ds-space-3); color: var(--ds-color-muted); }
  .sampling-workflow__action { margin-top: var(--ds-space-8); padding-top: var(--ds-space-3); border-top: 1px solid var(--ds-color-border); color: var(--ds-color-muted); font-size: .8125rem; }
  @media (min-width: 64rem) { .sampling-workflow article { padding: var(--ds-space-8); } }
</style>
