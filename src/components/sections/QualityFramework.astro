---
import ActionLink from "../primitives/ActionLink.astro";
import Container from "../primitives/Container.astro";
import SectionHeading from "../primitives/SectionHeading.astro";

interface QualityCheckpoint {
  stage: string;
  controlPurpose: string;
  evidenceType?: string;
}

interface QualityAction {
  href: string;
  label: string;
  ariaLabel?: string;
}

interface Props {
  id: string;
  eyebrow?: string;
  title: string;
  description?: string;
  checkpoints: readonly QualityCheckpoint[];
  evidenceLabel?: string;
  verificationAction?: QualityAction;
  class?: string;
}

const {
  id,
  eyebrow,
  title,
  description,
  checkpoints,
  evidenceLabel = "Evidence type",
  verificationAction,
  class: className,
} = Astro.props;

const headingId = `${id}-title`;
---

<section id={id} class:list={["quality-framework", className]} aria-labelledby={headingId}>
  <Container>
    <div class="quality-framework__intro">
      <SectionHeading
        id={headingId}
        eyebrow={eyebrow}
        title={title}
        description={description}
      />
      {verificationAction && (
        <ActionLink
          href={verificationAction.href}
          label={verificationAction.label}
          ariaLabel={verificationAction.ariaLabel}
          variant="text"
        />
      )}
    </div>

    <ol class="quality-framework__list">
      {checkpoints.map((checkpoint, index) => (
        <li>
          <article>
            <p class="quality-framework__index" aria-hidden="true">
              {String(index + 1).padStart(2, "0")}
            </p>
            <div>
              <h3>{checkpoint.stage}</h3>
              <p>{checkpoint.controlPurpose}</p>
            </div>
            {checkpoint.evidenceType && (
              <dl>
                <dt>{evidenceLabel}</dt>
                <dd>{checkpoint.evidenceType}</dd>
              </dl>
            )}
          </article>
        </li>
      ))}
    </ol>
  </Container>
</section>

<style>
  .quality-framework {
    border-block: 1px solid var(--ds-color-border);
    background: var(--ds-color-surface);
    padding-block: var(--ds-section-standard);
  }

  .quality-framework__intro {
    display: grid;
    gap: var(--ds-space-6);
    align-items: end;
  }

  .quality-framework__intro > :global(.action-link) {
    justify-self: start;
  }

  .quality-framework__list {
    display: grid;
    gap: 0;
    margin: var(--ds-space-12) 0 0;
    padding: 0;
    list-style: none;
  }

  .quality-framework__list li {
    border-top: 1px solid var(--ds-color-border);
  }

  .quality-framework article {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: var(--ds-space-4);
    padding-block: var(--ds-space-6);
  }

  .quality-framework__index {
    margin: 0;
    color: var(--ds-color-accent);
    font-size: 0.75rem;
    font-weight: 750;
    letter-spacing: 0.08em;
  }

  .quality-framework h3,
  .quality-framework article p,
  .quality-framework dl,
  .quality-framework dd {
    margin: 0;
  }

  .quality-framework h3 {
    font-size: 1.125rem;
    line-height: 1.3;
  }

  .quality-framework article div > p {
    max-width: 56ch;
    margin-top: var(--ds-space-2);
    color: var(--ds-color-muted);
  }

  .quality-framework dl {
    grid-column: 2;
    border-left: 2px solid var(--ds-color-border);
    padding-left: var(--ds-space-3);
  }

  .quality-framework dt {
    color: var(--ds-color-accent);
    font-size: 0.6875rem;
    font-weight: 750;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .quality-framework dd {
    margin-top: var(--ds-space-1);
    font-size: 0.9375rem;
  }

  @media (min-width: 48rem) {
    .quality-framework__intro {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .quality-framework article {
      grid-template-columns: 3.5rem minmax(0, 1.35fr) minmax(14rem, 0.65fr);
      gap: var(--ds-space-6);
      align-items: start;
      padding-block: var(--ds-space-8);
    }

    .quality-framework dl {
      grid-column: auto;
    }
  }
</style>
