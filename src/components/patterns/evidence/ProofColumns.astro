---
import SectionHeading from "../../primitives/SectionHeading.astro";
import type { EvidenceContent } from "../../../content-models/sections";

interface Props extends EvidenceContent {
  id: string;
}

const { id, eyebrow, title, description, points } = Astro.props;
---

<section class="proof-columns" aria-labelledby={`${id}-title`}>
  <div class="proof-columns__inner">
    <SectionHeading id={`${id}-title`} {eyebrow} {title} {description} />
    <div class="proof-columns__grid">
      {points.map((item, index) => (
        <article class="proof-columns__item">
          <span aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
          <h3>{item.title}</h3>
          <p>{item.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .proof-columns { padding: var(--space-section) var(--gutter); background: var(--color-surface-subtle); }
  .proof-columns__inner { width: min(100%, var(--container-wide)); margin-inline: auto; }
  .proof-columns__grid { display: grid; gap: 1px; margin-top: var(--space-10); background: var(--color-border); border: 1px solid var(--color-border); }
  .proof-columns__item { padding: clamp(1.5rem, 3vw, 2.5rem); background: var(--color-surface); }
  .proof-columns__item > span { color: var(--color-accent); font-size: var(--text-sm); font-weight: 700; }
  h3 { margin: var(--space-5) 0 var(--space-3); font-size: var(--text-xl); }
  p { margin: 0; color: var(--color-text-muted); }
  @media (min-width: 48rem) { .proof-columns__grid { grid-template-columns: repeat(3, 1fr); } }
</style>
