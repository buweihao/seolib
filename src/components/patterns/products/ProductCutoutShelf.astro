---
import type { ProductShelfContent } from "../../../content-models/sections";
import ActionLink from "../../primitives/ActionLink.astro";
interface Props extends ProductShelfContent { id?: string; headingLevel?: "h2" | "h3"; }
const { id, headingLevel="h2", eyebrow, title, description, products, action, note } = Astro.props;
const HeadingTag=headingLevel;
const CardHeadingTag=headingLevel === "h2" ? "h3" : "h4";
---
<section id={id} class="product-cutout-shelf" aria-labelledby={id?`${id}-title`:undefined}>
  <header>
    {eyebrow&&<p>{eyebrow}</p>}
    <HeadingTag id={id?`${id}-title`:undefined}>{title}</HeadingTag>
    {description&&<span>{description}</span>}
  </header>
  <ul role="list">
    {products.map(product=><li>
      <figure><img src={product.media.src} srcset={product.media.srcset} sizes={product.media.sizes} alt={product.media.alt} width={product.media.width} height={product.media.height} loading="lazy" decoding="async" /></figure>
      {product.category&&<p>{product.category}</p>}
      <CardHeadingTag>{product.name}</CardHeadingTag>
      {product.detail&&<span>{product.detail}</span>}
      {product.action&&<a href={product.action.href} aria-label={product.action.ariaLabel}>{product.action.label}<span aria-hidden="true"> →</span></a>}
    </li>)}
  </ul>
  {action&&<div class="product-cutout-shelf__action"><ActionLink {...action} variant="primary" /></div>}
  {note&&<p class="product-cutout-shelf__note">{note}</p>}
</section>
<style>
  .product-cutout-shelf{padding:clamp(3rem,7vw,7rem) var(--ds-page-gutter);background:#fff;color:#252825}
  .product-cutout-shelf>header{text-align:center}.product-cutout-shelf>header p,.product-cutout-shelf>header :is(h2,h3),.product-cutout-shelf>header span{margin:0}.product-cutout-shelf>header p{color:#60744d;font-size:.75rem;font-weight:800;letter-spacing:.13em;text-transform:uppercase}.product-cutout-shelf>header :is(h2,h3){margin-top:.5rem;font-family:Georgia,"Times New Roman",serif;font-size:clamp(2.2rem,5vw,4.5rem);font-weight:400;letter-spacing:.02em;text-transform:uppercase}.product-cutout-shelf>header>span{display:block;max-width:60ch;margin:1rem auto 0;color:#626862}
  .product-cutout-shelf ul{display:grid;gap:clamp(2rem,5vw,5rem);width:min(100%,82rem);margin:clamp(2.5rem,6vw,5rem) auto 0;padding:0;list-style:none}.product-cutout-shelf li{min-width:0;text-align:center}.product-cutout-shelf figure{position:relative;aspect-ratio:4/3;margin:0;overflow:hidden;background:transparent}.product-cutout-shelf img{position:absolute;inset:0;display:block;width:100%;height:100%;object-fit:contain}.product-cutout-shelf li p,.product-cutout-shelf li :is(h3,h4),.product-cutout-shelf li>span{margin:0}.product-cutout-shelf li p{margin-top:1rem;color:#74806b;font-size:.7rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase}.product-cutout-shelf li :is(h3,h4){margin-top:.35rem;font-size:1rem;font-weight:650}.product-cutout-shelf li>span{display:block;margin-top:.35rem;color:#747874;font-size:.85rem}.product-cutout-shelf li>a{display:inline-block;margin-top:.75rem;color:inherit;font-size:.85rem;font-weight:750}.product-cutout-shelf__action{display:flex;justify-content:center;margin-top:2.5rem}.product-cutout-shelf__note{max-width:65ch;margin:1.5rem auto 0;color:#747874;font-size:.8rem;text-align:center}
  @media(min-width:42rem){.product-cutout-shelf ul{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(min-width:70rem){.product-cutout-shelf ul{grid-template-columns:repeat(4,minmax(0,1fr))}}
</style>
