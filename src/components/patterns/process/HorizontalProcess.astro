---
import SectionHeading from "../../primitives/SectionHeading.astro";
import type { ProcessContent } from "../../../content-models/sections";

interface Props extends ProcessContent { id: string; }
const { id, eyebrow, title, description, steps } = Astro.props;
---

<section class="horizontal-process" aria-labelledby={`${id}-title`}>
  <div class="horizontal-process__inner">
    <SectionHeading id={`${id}-title`} {eyebrow} {title} {description} />
    <ol class="horizontal-process__steps">
      {steps.map((step, index) => (
        <li>
          <span>{String(index + 1).padStart(2, "0")}</span>
          <div><h3>{step.title}</h3><p>{step.description}</p></div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .horizontal-process { padding: var(--space-section) var(--gutter); }
  .horizontal-process__inner { width: min(100%, var(--container-wide)); margin-inline: auto; }
  ol { list-style: none; padding: 0; margin: var(--space-10) 0 0; display: grid; gap: var(--space-8); }
  li { position: relative; display: grid; grid-template-columns: auto 1fr; gap: var(--space-5); }
  li > span { display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border-radius: 50%; background: var(--color-accent); color: var(--color-on-accent); font-weight: 700; }
  h3 { margin: 0 0 var(--space-2); font-size: var(--text-lg); }
  p { margin: 0; color: var(--color-text-muted); }
  @media (min-width: 64rem) {
    ol { grid-template-columns: repeat(4, 1fr); }
    li { grid-template-columns: 1fr; }
    li:not(:last-child)::after { content: ""; position: absolute; top: 1.375rem; left: 3.5rem; right: -1.5rem; border-top: 1px solid var(--color-border-strong); }
    li > span { position: relative; z-index: 1; }
  }
</style>
