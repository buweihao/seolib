---
import SectionHeading from "../../primitives/SectionHeading.astro";
import type { QualityContent } from "../../../content-models/sections";

interface Props extends QualityContent { id: string; }
const { id, eyebrow, title, description, checkpoints } = Astro.props;
---

<section class="quality-matrix" aria-labelledby={`${id}-title`}>
  <div class="quality-matrix__inner">
    <SectionHeading id={`${id}-title`} {eyebrow} {title} {description} />
    <div class="quality-matrix__table" role="list">
      {checkpoints.map((item, index) => (
        <article role="listitem">
          <span>{String(index + 1).padStart(2, "0")}</span>
          <div><h3>{item.stage}</h3><p>{item.controlPurpose}</p></div>
          <strong>{item.evidenceType ?? "Evidence to confirm"}</strong>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .quality-matrix { padding: var(--space-section) var(--gutter); }
  .quality-matrix__inner { width: min(100%, var(--container-wide)); margin-inline: auto; }
  .quality-matrix__table { margin-top: var(--space-10); border-top: 1px solid var(--color-border-strong); }
  article { display: grid; grid-template-columns: auto 1fr; gap: var(--space-4); padding: var(--space-6) 0; border-bottom: 1px solid var(--color-border); }
  article > span { color: var(--color-accent); font-weight: 700; }
  h3 { margin: 0 0 var(--space-2); font-size: var(--text-lg); }
  p { margin: 0; color: var(--color-text-muted); }
  strong { grid-column: 2; color: var(--color-text-muted); font-size: var(--text-sm); text-transform: uppercase; letter-spacing: .06em; }
  @media (min-width: 48rem) { article { grid-template-columns: 3rem 1fr auto; align-items: center; } strong { grid-column: auto; } }
</style>
