---
import { componentChineseNames, componentRegistry } from "../../config/component-registry";

const families = [...new Set(componentRegistry.map((component) => component.family))];
const familyLabels: Record<string, string> = {
  Primitives: "基础原语", Hero: "首屏 Hero", Products: "产品", Evidence: "证据", Process: "流程", Pathways: "合作路线",
  Audience: "目标客户", Facility: "工厂设施", Quality: "质量", Capabilities: "能力", Inquiry: "询盘与联系", Proof: "信任证明",
  Commercial: "商业条件", Services: "服务", Navigation: "导航与动效", Media: "媒体", Story: "品牌与公司叙事",
  Resources: "资源", "Site shell": "全站框架", "Inner pages": "内页", Compositions: "页面组合",
};
---

<section class="registry" aria-labelledby="component-registry-title">
  <div class="registry__intro">
    <p>单一事实来源</p>
    <h2 id="component-registry-title">全部 {componentRegistry.length} 个已登记组件</h2>
    <p>每个面向用户的组件都必须在这里登记，并链接到独立审核或页面场景。新增组件未登记时，自动测试会失败。</p>
  </div>
  <div class="registry__families">
    {families.map((family) => (
      <section aria-labelledby={`registry-${family.toLowerCase().replaceAll(" ", "-")}`}>
        <h3 id={`registry-${family.toLowerCase().replaceAll(" ", "-")}`}>{familyLabels[family] ?? family}</h3>
        <ul role="list">
          {componentRegistry.filter((component) => component.family === family).map((component) => (
            <li>
              <a href={component.reviewHref}>
                <span><strong>{componentChineseNames[component.id]}</strong><small>{component.id}</small></span>
                <span class:list={["registry__status", `is-${component.status.toLowerCase()}`]}>{component.status === "Approved" ? "已通过" : "审核中"}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</section>

<style>
  .registry { margin-bottom: var(--ds-section-feature); padding: clamp(1.25rem, 4vw, 2.5rem); border: 1px solid var(--ds-color-border); background: var(--ds-color-surface-subtle); }
  .registry__intro > p:first-child { margin: 0; color: var(--ds-color-accent); font-size: .75rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
  .registry__intro h2 { margin: var(--ds-space-2) 0 0; font-size: clamp(1.75rem, 4vw, 3rem); }
  .registry__intro h2 + p { max-width: 68ch; margin: var(--ds-space-3) 0 0; color: var(--ds-color-muted); }
  .registry__families { display: grid; gap: var(--ds-space-8); margin-top: var(--ds-space-10); }
  .registry__families h3 { margin: 0 0 var(--ds-space-3); font-size: 1rem; text-transform: uppercase; letter-spacing: .06em; }
  ul { display: grid; gap: 1px; margin: 0; padding: 1px; background: var(--ds-color-border); list-style: none; }
  li { background: var(--ds-color-surface); }
  li a { display: flex; align-items: center; justify-content: space-between; gap: var(--ds-space-4); min-height: 3.5rem; padding: var(--ds-space-3) var(--ds-space-4); color: inherit; text-decoration: none; }
  li a:hover { background: color-mix(in oklch, var(--ds-color-accent), white 93%); }
  li a:focus-visible { outline: 3px solid var(--ds-color-accent); outline-offset: -3px; }
  li span:first-child { display: grid; }
  li small { color: var(--ds-color-muted); }
  .registry__status { border: 1px solid var(--ds-color-border); border-radius: 999px; padding: .25rem .55rem; font-size: .7rem; font-weight: 800; text-transform: uppercase; }
  .registry__status.is-approved { border-color: color-mix(in oklch, var(--ds-color-accent), white 55%); color: var(--ds-color-accent); }
  @media (min-width: 48rem) { .registry__families { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 72rem) { .registry__families { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>
