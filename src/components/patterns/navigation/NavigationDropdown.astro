---
interface NavigationDropdownItem { label: string; href: string; description?: string; marker?: string; }
interface Props {
  id: string;
  label: string;
  items: NavigationDropdownItem[];
  introTitle?: string;
  introDescription?: string;
  open?: boolean;
  variant?: "compact" | "feature";
  align?: "start" | "end";
  embedded?: boolean;
  current?: boolean;
}
const { id, label, items, introTitle, introDescription, open = false, variant = "compact", align = "start", embedded = false, current = false } = Astro.props;
---
<div id={id} class:list={["navigation-dropdown", `navigation-dropdown--${variant}`, `navigation-dropdown--${align}`, { "navigation-dropdown--embedded": embedded }]} role={embedded ? undefined : "navigation"} aria-label={embedded ? undefined : `${label} submenu example`} data-navigation-dropdown data-embedded={String(embedded)}>
  <details {open}>
    <summary aria-current={current ? "page" : undefined}>{label}<span aria-hidden="true"></span></summary>
    <div class="navigation-dropdown__panel">
      {(introTitle || introDescription) && <div class="navigation-dropdown__intro">{introTitle && <h3>{introTitle}</h3>}{introDescription && <p>{introDescription}</p>}</div>}
      <ul role="list">{items.map((item) => <li><a href={item.href}>{item.marker && <span aria-hidden="true">{item.marker}</span>}<div><strong>{item.label}</strong>{item.description && <small>{item.description}</small>}</div></a></li>)}</ul>
    </div>
  </details>
</div>
<script>
  function initializeNavigationDropdowns() {
    document.querySelectorAll<HTMLElement>("[data-navigation-dropdown]").forEach((root) => {
      if (root.dataset.ready === "true" || root.dataset.embedded !== "true") return;
      root.dataset.ready = "true";
      const details = root.querySelector<HTMLDetailsElement>("details");
      if (!details) return;
      const supportsHover = window.matchMedia("(min-width: 64rem) and (hover: hover) and (pointer: fine)");
      let closeTimer: number | undefined;
      const closeOtherDropdowns = () => {
        document.querySelectorAll<HTMLElement>('[data-navigation-dropdown][data-embedded="true"]').forEach((otherRoot) => {
          if (otherRoot === root) return;
          const otherDetails = otherRoot.querySelector<HTMLDetailsElement>("details");
          if (otherDetails) otherDetails.open = false;
        });
      };
      const cancelClose = () => {
        if (closeTimer !== undefined) window.clearTimeout(closeTimer);
        closeTimer = undefined;
      };
      const scheduleClose = () => {
        cancelClose();
        closeTimer = window.setTimeout(() => {
          if (!root.matches(":hover") && !root.contains(document.activeElement)) details.open = false;
        }, 350);
      };
      root.addEventListener("pointerenter", () => {
        if (!supportsHover.matches) return;
        cancelClose();
        closeOtherDropdowns();
        details.open = true;
      });
      root.addEventListener("pointerleave", () => { if (supportsHover.matches) scheduleClose(); });
      root.addEventListener("focusin", cancelClose);
      root.addEventListener("focusout", (event) => { if (!root.contains(event.relatedTarget as Node | null)) details.open = false; });
      details.addEventListener("toggle", () => { if (details.open) closeOtherDropdowns(); });
    });
  }
  initializeNavigationDropdowns();
  document.addEventListener("astro:page-load", initializeNavigationDropdowns);
</script>
<style>
  .navigation-dropdown { position: relative; display: flex; min-height: 34rem; align-items: flex-start; padding: 3rem; background: linear-gradient(135deg, var(--ds-color-surface), color-mix(in oklch, var(--ds-color-accent), white 92%)); }
  .navigation-dropdown--end { justify-content: flex-end; }
  details { position: relative; width: min(100%, 20rem); }
  summary { display: inline-flex; min-height: 2.75rem; align-items: center; gap: .5rem; border-radius: var(--ds-radius-control); padding: .65rem .9rem; background: var(--ds-color-surface); font-weight: 800; cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary span { width: .5rem; height: .5rem; border-right: 1.5px solid; border-bottom: 1.5px solid; transform: rotate(45deg) translateY(-.15rem); }
  details[open] summary span { transform: rotate(225deg) translate(-.1rem, -.1rem); }
  .navigation-dropdown__panel { position: absolute; z-index: 2; top: calc(100% + .5rem); left: 0; width: min(36rem, calc(100vw - 4rem)); border: 1px solid var(--ds-color-border); border-radius: var(--ds-radius-card); padding: .75rem; background: color-mix(in oklch, var(--ds-color-surface), transparent 2%); box-shadow: 0 1rem 2.5rem rgb(10 16 35 / .16); }
  .navigation-dropdown--end .navigation-dropdown__panel { right: 0; left: auto; }
  .navigation-dropdown__intro { padding: 1rem; border-bottom: 1px solid var(--ds-color-border); }
  .navigation-dropdown__intro h3 { margin: 0; font-size: 1rem; }
  .navigation-dropdown__intro p { margin: .5rem 0 0; color: var(--ds-color-muted); font-size: .9rem; }
  ul { display: grid; gap: .15rem; margin: 0; padding: 0; list-style: none; }
  a { display: grid; grid-template-columns: auto 1fr; gap: .75rem; align-items: center; min-height: 3rem; border-radius: .4rem; padding: .65rem .75rem; text-decoration: none; }
  a:hover { background: color-mix(in oklch, var(--ds-color-accent), white 92%); }
  a > span { display: grid; width: 2.25rem; height: 2.25rem; place-items: center; border-radius: 999px; background: color-mix(in oklch, var(--ds-color-accent), white 86%); color: var(--ds-color-accent); font-weight: 800; }
  strong, small { display: block; }
  small { margin-top: .1rem; color: var(--ds-color-muted); }
  .navigation-dropdown--feature details { width: min(100%, 30rem); }
  .navigation-dropdown--feature .navigation-dropdown__panel { width: min(48rem, calc(100vw - 4rem)); }
  .navigation-dropdown--feature ul { padding-top: .5rem; }
  @media (min-width: 48rem) {
    .navigation-dropdown--feature .navigation-dropdown__panel { display: grid; grid-template-columns: minmax(13rem, .8fr) minmax(0, 1.2fr); }
    .navigation-dropdown--feature .navigation-dropdown__intro { border-right: 1px solid var(--ds-color-border); border-bottom: 0; }
    .navigation-dropdown--feature ul { grid-template-columns: repeat(2, minmax(0, 1fr)); padding: .5rem; }
  }
  .navigation-dropdown--embedded { display: block; min-height: 0; padding: 0; background: transparent; }
  .navigation-dropdown--embedded details, .navigation-dropdown--embedded.navigation-dropdown--feature details { width: auto; }
  .navigation-dropdown--embedded summary { background: transparent; }
  .navigation-dropdown--embedded summary[aria-current="page"] { color: var(--ds-color-accent); text-decoration: underline; text-underline-offset: .35rem; }
  .navigation-dropdown--embedded .navigation-dropdown__panel { top: calc(100% + .25rem); }
  .navigation-dropdown--embedded.navigation-dropdown--feature .navigation-dropdown__panel { width: min(48rem, calc(100vw - 2rem)); }
  @media (max-width: 35rem) {
    .navigation-dropdown { min-height: 38rem; padding: 1.25rem; }
    details { width: 100%; }
    summary { width: 100%; justify-content: space-between; }
    .navigation-dropdown__panel, .navigation-dropdown--feature .navigation-dropdown__panel { position: static; width: 100%; margin-top: .5rem; box-shadow: none; }
  }
  @media (max-width: 63.99rem) {
    .navigation-dropdown--embedded details { width: 100%; }
    .navigation-dropdown--embedded summary { width: 100%; justify-content: space-between; }
    .navigation-dropdown--embedded .navigation-dropdown__panel,
    .navigation-dropdown--embedded.navigation-dropdown--feature .navigation-dropdown__panel { position: static; width: 100%; margin-top: .25rem; box-shadow: none; }
  }
</style>
