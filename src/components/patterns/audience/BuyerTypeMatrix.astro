---
import type { BuyerMatrixContent } from "../../../content-models/sections";
import SectionHeading from "../../primitives/SectionHeading.astro";
interface Props extends BuyerMatrixContent { id: string; }
const { id, eyebrow, title, description, buyers, action, note } = Astro.props;
---
<section id={id} class="buyer-matrix" aria-labelledby={`${id}-title`}><div class="inner">
  <header><SectionHeading id={`${id}-title`} {eyebrow} {title} {description} />{action && <a href={action.href}>{action.label}</a>}</header>
  <div class="grid">{buyers.map((buyer) => <article><p class="tag">{buyer.name}</p><p>{buyer.description}</p><dl><div><dt>Typical need</dt><dd>{buyer.typicalNeed}</dd></div><div><dt>We deliver</dt><dd>{buyer.deliverable}</dd></div></dl></article>)}</div>
  {note && <p class="note">{note}</p>}
</div></section>
<style>
  .buyer-matrix { padding: var(--ds-section-standard) var(--ds-page-gutter); background: color-mix(in oklch, var(--ds-color-canvas), var(--ds-color-accent) 4%); }
  .inner { width: min(100%, var(--ds-container-wide)); margin-inline: auto; border: 1px solid var(--ds-color-border); border-radius: var(--ds-radius-card); background: var(--ds-color-surface); overflow: hidden; }
  header { display: grid; gap: var(--ds-space-4); padding: var(--ds-space-6); border-bottom: 1px solid var(--ds-color-border); }
  header > a { align-self: center; justify-self: start; padding: .65rem 1rem; border: 1px solid var(--ds-color-border); border-radius: 99rem; font-weight: 700; text-decoration: none; }
  .grid { display: grid; gap: var(--ds-space-4); padding: var(--ds-space-6); }
  article { padding: var(--ds-space-4); border: 1px solid var(--ds-color-border); border-radius: var(--ds-radius-card); }
  .tag { display: inline-block; margin: 0; padding: .35rem .65rem; border-radius: 99rem; background: color-mix(in oklch, var(--ds-color-accent), white 88%); color: var(--ds-color-accent); font-weight: 750; }
  dl, dd { margin: 0; } dl { display: grid; gap: var(--ds-space-3); } dt { font-weight: 750; } dd { color: var(--ds-color-muted); }
  .note { margin: 0; padding: 0 var(--ds-space-6) var(--ds-space-6); color: var(--ds-color-muted); }
  @media (min-width: 48rem) { header { grid-template-columns: 1fr auto; } .grid { grid-template-columns: repeat(2,1fr); } }
  @media (min-width: 72rem) { .grid { grid-template-columns: repeat(4,1fr); } }
</style>