---
import type { RecognitionHeroContent } from "../../../content-models/sections";

interface Props extends RecognitionHeroContent { id?: string; headingLevel?: "h1" | "h2" | "h3"; }
const { id, headingLevel = "h1", slides, autoplayMs = 6000 } = Astro.props;
const carouselId = id ?? `image-carousel-${Math.random().toString(36).slice(2)}`;
const firstTitle = slides[0]?.title?.trim();
---

<section id={carouselId} class="image-carousel" aria-roledescription="carousel" aria-label="Homepage highlights" data-image-carousel data-autoplay-ms={autoplayMs}>
  {!firstTitle && headingLevel === "h1" && <h1 class="visually-hidden">Homepage</h1>}
  <div class="image-carousel__viewport" aria-live="off">
    {slides.map((slide, slideIndex) => {
      const SlideHeadingTag = slideIndex === 0 ? headingLevel : headingLevel === "h1" ? "h2" : headingLevel;
      const clickLabel = slide.title || slide.action?.label || slide.media.alt;
      const image = <img src={slide.media.src} srcset={slide.media.srcset} sizes={slide.media.sizes} alt={slide.media.alt} width={slide.media.width} height={slide.media.height} loading={slideIndex === 0 ? "eager" : "lazy"} fetchpriority={slideIndex === 0 ? "high" : "auto"} decoding="async" />;
      return (
        <article class="image-carousel__slide" data-slide data-active={slideIndex === 0 ? "true" : "false"} aria-hidden={slideIndex === 0 ? "false" : "true"} aria-label={`${slideIndex + 1} of ${slides.length}`} aria-roledescription="slide">
          {slide.href ? <a class="image-carousel__image-link" href={slide.href} aria-label={clickLabel}>{image}</a> : <div class="image-carousel__image-link">{image}</div>}
          {(slide.title || slide.action) && <div class="image-carousel__message" aria-hidden={slide.href ? "true" : undefined}>
            {slide.title && <SlideHeadingTag>{slide.title}</SlideHeadingTag>}
            {slide.action && <span class="image-carousel__button">{slide.action.label}<span aria-hidden="true">→</span></span>}
          </div>}
        </article>
      );
    })}
    {slides.length > 1 && <>
      <button class="image-carousel__arrow image-carousel__arrow--previous" type="button" data-previous aria-label="Previous slide"><span aria-hidden="true">←</span></button>
      <button class="image-carousel__arrow image-carousel__arrow--next" type="button" data-next aria-label="Next slide"><span aria-hidden="true">→</span></button>
      <div class="image-carousel__controls">
        <div class="image-carousel__dots" role="group" aria-label="Choose slide">
          {slides.map((slide, index) => <button type="button" data-dot={index} aria-label={`Show slide ${index + 1}${slide.title ? `: ${slide.title}` : ""}`} aria-current={index === 0 ? "true" : "false"}></button>)}
        </div>
        <button class="image-carousel__toggle" type="button" data-toggle aria-label="Pause automatic rotation"><span data-pause aria-hidden="true">Ⅱ</span><span data-play aria-hidden="true" hidden>▶</span></button>
      </div>
    </>}
  </div>
  <p class="visually-hidden" data-status aria-live="polite"></p>
</section>

<script>
  const setupImageCarousel = (root: HTMLElement) => {
    if (root.dataset.ready === "true") return;
    root.dataset.ready = "true";
    const slides = [...root.querySelectorAll<HTMLElement>("[data-slide]")];
    const dots = [...root.querySelectorAll<HTMLButtonElement>("[data-dot]")];
    const status = root.querySelector<HTMLElement>("[data-status]");
    const toggle = root.querySelector<HTMLButtonElement>("[data-toggle]");
    const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const delay = Number(root.dataset.autoplayMs) || 6000;
    let current = 0;
    let timer: number | undefined;
    let paused = reducedMotion;
    const show = (next: number, announce = true) => {
      current = (next + slides.length) % slides.length;
      slides.forEach((slide, index) => { const active = index === current; slide.dataset.active = String(active); slide.setAttribute("aria-hidden", String(!active)); });
      dots.forEach((dot, index) => dot.setAttribute("aria-current", String(index === current)));
      if (announce && status) status.textContent = `Showing slide ${current + 1} of ${slides.length}`;
    };
    const stop = () => { if (timer) window.clearInterval(timer); timer = undefined; };
    const start = () => { stop(); if (!paused && slides.length > 1) timer = window.setInterval(() => show(current + 1, false), delay); };
    const renderToggle = () => { if (!toggle) return; toggle.setAttribute("aria-label", paused ? "Start automatic rotation" : "Pause automatic rotation"); toggle.querySelector<HTMLElement>("[data-pause]")!.hidden = paused; toggle.querySelector<HTMLElement>("[data-play]")!.hidden = !paused; };
    root.querySelector("[data-previous]")?.addEventListener("click", () => { show(current - 1); start(); });
    root.querySelector("[data-next]")?.addEventListener("click", () => { show(current + 1); start(); });
    dots.forEach((dot, index) => dot.addEventListener("click", () => { show(index); start(); }));
    toggle?.addEventListener("click", () => { paused = !paused; renderToggle(); start(); });
    root.addEventListener("mouseenter", stop); root.addEventListener("mouseleave", start); root.addEventListener("focusin", stop);
    root.addEventListener("focusout", (event) => { if (!root.contains((event as FocusEvent).relatedTarget as Node | null)) start(); });
    root.addEventListener("keydown", (event) => { if (event.key === "ArrowLeft") { event.preventDefault(); show(current - 1); } if (event.key === "ArrowRight") { event.preventDefault(); show(current + 1); } });
    renderToggle(); start();
  };
  document.querySelectorAll<HTMLElement>("[data-image-carousel]").forEach(setupImageCarousel);
  document.addEventListener("astro:page-load", () => document.querySelectorAll<HTMLElement>("[data-image-carousel]").forEach(setupImageCarousel));
</script>

<style>
  .image-carousel{position:relative;overflow:hidden;background:var(--ds-color-ink);color:#fff}.image-carousel__viewport{position:relative;display:grid;min-height:clamp(32rem,56vw,50rem)}.image-carousel__slide{position:relative;grid-area:1/1;min-width:0;min-height:inherit;opacity:1;transition:opacity .45s ease}.image-carousel__slide[data-active=false]{visibility:hidden;opacity:0;pointer-events:none}.image-carousel__image-link{position:absolute;inset:0;display:block;background:var(--ds-color-ink)}.image-carousel__image-link:after{position:absolute;inset:0;background:linear-gradient(90deg,rgb(0 0 0/.18),transparent 35%,transparent 65%,rgb(0 0 0/.18));content:"";pointer-events:none}.image-carousel__image-link img{display:block;width:100%;height:100%;object-fit:cover}.image-carousel__message{position:absolute;z-index:3;left:50%;top:50%;display:grid;width:min(90%,66rem);justify-items:center;gap:1.25rem;transform:translate(-50%,-50%);text-align:center;pointer-events:none}.image-carousel__message :is(h1,h2,h3){max-width:20ch;margin:0;padding:.2em .45em;background:rgb(25 30 31/.68);color:#fff;font-size:clamp(2.1rem,5vw,4.8rem);font-weight:450;line-height:1.04;text-wrap:balance;backdrop-filter:blur(.2rem)}.image-carousel__button{display:inline-flex;min-height:3rem;align-items:center;gap:.65rem;border:1px solid rgb(255 255 255/.78);border-radius:var(--ds-radius-control);padding:.7rem 1.15rem;background:var(--ds-color-accent);color:var(--ds-color-accent-contrast);font-weight:700;box-shadow:0 .6rem 1.5rem rgb(0 0 0/.22)}
  .image-carousel__arrow{position:absolute;z-index:5;top:50%;display:grid;width:3.25rem;aspect-ratio:1;place-items:center;border:1px solid rgb(255 255 255/.68);border-radius:50%;background:rgb(20 25 25/.55);color:#fff;font-size:1.2rem;transform:translateY(-50%);backdrop-filter:blur(.35rem);cursor:pointer}.image-carousel__arrow--previous{left:clamp(.75rem,2.5vw,2.5rem)}.image-carousel__arrow--next{right:clamp(.75rem,2.5vw,2.5rem)}.image-carousel__controls{position:absolute;z-index:5;left:50%;bottom:1rem;display:flex;align-items:center;gap:.7rem;transform:translateX(-50%)}.image-carousel__dots{display:flex;gap:.5rem}.image-carousel__dots button,.image-carousel__toggle{display:grid;min-width:2.75rem;min-height:2.75rem;place-items:center;border:1px solid rgb(255 255 255/.58);border-radius:999px;background:rgb(20 25 25/.52);color:#fff;cursor:pointer;backdrop-filter:blur(.35rem)}.image-carousel__dots button:after{width:.55rem;height:.55rem;border-radius:50%;background:rgb(255 255 255/.5);content:""}.image-carousel__dots button[aria-current=true]:after{background:#fff;transform:scale(1.35)}.image-carousel__arrow:hover,.image-carousel__dots button:hover,.image-carousel__toggle:hover{background:rgb(20 25 25/.82)}.image-carousel__image-link:focus-visible{outline:.25rem solid #fff;outline-offset:-.35rem}.visually-hidden{position:absolute;width:1px;height:1px;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
  @media(max-width:40rem){.image-carousel__viewport{min-height:35rem}.image-carousel__message{width:82%}.image-carousel__message :is(h1,h2,h3){font-size:clamp(2rem,10vw,3.2rem)}.image-carousel__arrow{top:auto;bottom:1rem;width:2.75rem;transform:none}.image-carousel__arrow--previous{left:.75rem}.image-carousel__arrow--next{right:.75rem}}@media(prefers-reduced-motion:reduce){.image-carousel__slide{transition:none}}
</style>
