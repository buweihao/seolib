---
export type FloatingContactItem = {
  label: string;
  icon: "phone" | "whatsapp" | "email" | "message" | "share";
  href?: string;
  value?: string;
  featured?: boolean;
};

interface Props {
  id: string;
  label: string;
  items: FloatingContactItem[];
  topLabel?: string;
  scrollTargetId?: string;
  shareSuccessLabel?: string;
  showAfterScroll?: boolean;
  showTop?: boolean;
  preview?: boolean;
}

const {
  id,
  label,
  items,
  topLabel = "Top",
  scrollTargetId,
  shareSuccessLabel = "Page link copied",
  showAfterScroll = true,
  showTop = true,
  preview = false,
} = Astro.props;

const initiallyVisible = preview || !showAfterScroll;
---

<aside
  id={id}
  class:list={["floating-contact-bar", { "floating-contact-bar--preview": preview }]}
  aria-label={label}
  data-floating-contact-bar
  data-scroll-target={scrollTargetId}
  data-share-success={shareSuccessLabel}
  data-show-after-scroll={showAfterScroll ? "true" : "false"}
  data-visible={initiallyVisible ? "true" : "false"}
>
  <nav aria-label={label}>
    <ul role="list">
      {items.map((item) => (
        <li class:list={{ "floating-contact-bar__item": true, "floating-contact-bar__item--featured": item.featured }}>
          {item.value && (
            <button
              type="button"
              class="floating-contact-bar__detail"
              data-copy-value={item.value}
              aria-label={`Copy ${item.label}: ${item.value}`}
              title={`Click to copy ${item.label}`}
            >
              <span class="floating-contact-bar__detail-label" data-label={item.label}>{item.label}</span>
              <strong class="floating-contact-bar__detail-value">{item.value}</strong>
            </button>
          )}
          {item.icon === "share" ? (
            <button type="button" class="floating-contact-bar__action" aria-label={item.label} data-contact-share>
              <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="18" cy="5" r="2.25" /><circle cx="6" cy="12" r="2.25" /><circle cx="18" cy="19" r="2.25" /><path d="m8 11 8-5M8 13l8 5" /></svg>
              <span class="floating-contact-bar__label">{item.label}</span>
            </button>
          ) : (
            <a href={item.href ?? "#"} class="floating-contact-bar__action" aria-label={item.value ? `${item.label}: ${item.value}` : item.label}>
              {item.icon === "phone" && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7.1 4.5 9.5 4l1.7 4-1.8 1.6a13.3 13.3 0 0 0 5 5l1.6-1.8 4 .1-.5 2.4c-.2 1-1 1.7-2 1.8-5.7.3-10.8-4.8-10.5-10.5.1-1 .8-1.8 1.8-2.1Z" /></svg>}
              {item.icon === "whatsapp" && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 11.6a8 8 0 0 1-11.8 7L4 20l1.4-4A8 8 0 1 1 20 11.6Z" /><path d="M9 8.3c.5 2.4 2.3 4.2 4.7 4.8l1-1.1c.2-.2.5-.3.8-.1l2 .9c.3.1.4.4.4.7-.1 1-.7 1.8-1.7 2.1-1.1.3-2.8-.1-4.6-1.1a11.3 11.3 0 0 1-4.1-4.1C6.5 8.6 6.1 7 6.4 5.8c.3-1 .9-1.5 1.8-1.7.3 0 .6.1.7.4l.9 2c.1.3.1.6-.1.8L9 8.3Z" /></svg>}
              {item.icon === "email" && <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5.5" width="17" height="13" rx="1" /><path d="m4.5 7 7.5 6 7.5-6" /></svg>}
              {item.icon === "message" && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5.5h16v11H8l-4 3v-14Z" /><path d="M8 10h.01M12 10h.01M16 10h.01" /></svg>}
              <span class="floating-contact-bar__label">{item.label}</span>
            </a>
          )}
        </li>
      ))}
      {showTop && (
        <li class="floating-contact-bar__top">
          <button type="button" class="floating-contact-bar__action" aria-label={topLabel} data-contact-top>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 14 7-7 7 7" /></svg>
            <span class="floating-contact-bar__label">{topLabel}</span>
          </button>
        </li>
      )}
    </ul>
  </nav>
  <p class="floating-contact-bar__status" role="status" aria-live="polite" data-contact-status></p>
</aside>

<script>
  function initializeFloatingContactBars() {
    document.querySelectorAll<HTMLElement>("[data-floating-contact-bar]").forEach((root) => {
      if (root.dataset.ready === "true") return;
      root.dataset.ready = "true";
      let ticking = false;
      const updateVisibility = () => {
        if (root.dataset.showAfterScroll !== "true") {
          root.dataset.visible = "true";
        } else {
          root.dataset.visible = window.scrollY > 80 ? "true" : "false";
        }
        ticking = false;
      };
      if (root.dataset.showAfterScroll === "true") {
        window.addEventListener("scroll", () => {
          if (!ticking) {
            window.requestAnimationFrame(updateVisibility);
            ticking = true;
          }
        }, { passive: true });
      }
      updateVisibility();
      const status = root.querySelector<HTMLElement>("[data-contact-status]");
      root.querySelectorAll<HTMLButtonElement>("[data-copy-value]").forEach((btn) => {
        btn.addEventListener("click", async (e) => {
          e.preventDefault();
          e.stopPropagation();
          const val = btn.dataset.copyValue;
          if (!val) return;
          try {
            await navigator.clipboard.writeText(val);
            btn.classList.add("floating-contact-bar__detail--copied");
            const labelEl = btn.querySelector<HTMLElement>(".floating-contact-bar__detail-label");
            const originalLabel = labelEl?.dataset.label || labelEl?.textContent || "";
            if (labelEl) labelEl.textContent = "Copied!";
            setTimeout(() => {
              btn.classList.remove("floating-contact-bar__detail--copied");
              if (labelEl) labelEl.textContent = originalLabel;
            }, 1600);
            if (status) status.textContent = `${val} copied to clipboard`;
          } catch {
            if (status) status.textContent = `Please copy: ${val}`;
          }
        });
      });
      root.querySelector<HTMLButtonElement>("[data-contact-share]")?.addEventListener("click", async () => {
        try {
          if (navigator.share) await navigator.share({ title: document.title, url: window.location.href });
          else await navigator.clipboard.writeText(window.location.href);
          if (status) status.textContent = root.dataset.shareSuccess ?? "";
        } catch (error) {
          if (error instanceof DOMException && error.name === "AbortError") return;
          if (status) status.textContent = "Copy the address from your browser to share this page.";
        }
      });
      root.querySelector<HTMLButtonElement>("[data-contact-top]")?.addEventListener("click", () => {
        const target = root.dataset.scrollTarget ? document.getElementById(root.dataset.scrollTarget) : null;
        if (target) target.scrollIntoView({ behavior: "smooth", block: "start" });
        else window.scrollTo({ top: 0, behavior: "smooth" });
      });
    });
  }

  initializeFloatingContactBars();
  document.addEventListener("astro:page-load", initializeFloatingContactBars);
</script>

<style>
  .floating-contact-bar {
    position: fixed;
    z-index: 55;
    right: clamp(.75rem, 2.5vw, 1.5rem);
    bottom: clamp(.75rem, 3vw, 1.75rem);
    transform: translateX(110%);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: transform .28s ease, opacity .2s ease, visibility 0s linear .28s;
    font-family: var(--ds-font-sans);
  }

  .floating-contact-bar[data-visible="true"] {
    transform: translateX(0);
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition-delay: 0s;
  }

  .floating-contact-bar--preview {
    position: absolute;
  }

  nav {
    overflow: visible;
    border: 1px solid color-mix(in oklch, var(--ds-color-ink), transparent 12%);
    border-radius: 2.9rem;
    background: var(--ds-color-ink);
    box-shadow: 0 1rem 2.5rem rgb(10 16 35 / .2);
  }

  ul {
    display: grid;
    width: 5.25rem;
    gap: .2rem;
    margin: 0;
    padding: .6rem;
    list-style: none;
  }

  .floating-contact-bar__item {
    position: relative;
  }

  .floating-contact-bar__action {
    position: relative;
    display: grid;
    width: 100%;
    min-height: 4rem;
    place-items: center;
    border: 0;
    border-radius: 50%;
    padding: .55rem;
    background: transparent;
    color: var(--ds-color-canvas);
    font: inherit;
    cursor: pointer;
    text-decoration: none;
    transition: background-color .2s ease, color .2s ease, transform .2s ease;
  }

  .floating-contact-bar__action:hover,
  .floating-contact-bar__action:focus-visible {
    background: color-mix(in oklch, var(--ds-color-canvas), transparent 88%);
  }

  .floating-contact-bar__item--featured .floating-contact-bar__action {
    background: var(--ds-color-accent);
    color: var(--ds-color-accent-contrast);
  }

  .floating-contact-bar__item--featured .floating-contact-bar__action:hover,
  .floating-contact-bar__item--featured .floating-contact-bar__action:focus-visible {
    background: color-mix(in oklch, var(--ds-color-accent), white 12%);
    transform: scale(1.03);
  }

  .floating-contact-bar__action:focus-visible {
    outline: 3px solid var(--ds-color-canvas);
    outline-offset: 3px;
  }

  .floating-contact-bar svg {
    width: 1.7rem;
    height: 1.7rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.7;
  }

  .floating-contact-bar__label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .floating-contact-bar__detail {
    position: absolute;
    right: calc(100% + .8rem);
    top: 50%;
    display: flex;
    flex-direction: column;
    gap: .25rem;
    width: max-content;
    min-width: 0;
    max-width: min(22rem, calc(100vw - 6rem));
    transform: translateY(-50%) translateX(.6rem);
    border: 0;
    border-radius: .85rem;
    padding: .75rem 1.1rem;
    background: var(--ds-color-ink);
    box-shadow: 0 .7rem 2rem rgb(10 16 35 / .24);
    color: var(--ds-color-canvas);
    font: inherit;
    text-align: left;
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
    transition: transform .2s ease, opacity .2s ease, background-color .2s ease, visibility 0s linear .2s;
  }

  .floating-contact-bar__detail:hover {
    background: color-mix(in oklch, var(--ds-color-ink), white 8%);
  }

  .floating-contact-bar__detail:focus-visible {
    outline: 2px solid var(--ds-color-accent);
    outline-offset: 2px;
  }

  .floating-contact-bar__detail::before {
    position: absolute;
    top: -8px;
    bottom: -8px;
    right: -1.2rem;
    width: 1.4rem;
    content: "";
  }

  .floating-contact-bar__detail::after {
    position: absolute;
    right: -.32rem;
    top: 50%;
    width: .65rem;
    height: .65rem;
    transform: translateY(-50%) rotate(45deg);
    background: inherit;
    content: "";
    transition: background-color .2s ease;
  }

  .floating-contact-bar__item:hover .floating-contact-bar__detail,
  .floating-contact-bar__item:focus-within .floating-contact-bar__detail {
    transform: translateY(-50%) translateX(0);
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition-delay: 0s;
  }

  .floating-contact-bar__detail-label {
    color: color-mix(in oklch, var(--ds-color-canvas), transparent 35%);
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    transition: color .2s ease;
  }

  .floating-contact-bar__detail-value {
    overflow-wrap: anywhere;
    font-size: .95rem;
    font-weight: 800;
    color: var(--ds-color-canvas);
    user-select: all;
  }

  .floating-contact-bar__detail--copied .floating-contact-bar__detail-label {
    color: var(--ds-color-accent, #10b981);
    font-weight: 800;
  }

  .floating-contact-bar__top {
    border-top: 1px solid color-mix(in oklch, var(--ds-color-canvas), transparent 82%);
    padding-top: .2rem;
  }

  .floating-contact-bar__top .floating-contact-bar__action {
    min-height: 3.4rem;
  }

  .floating-contact-bar__status {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (max-width: 47.99rem) {
    .floating-contact-bar {
      right: .65rem;
      bottom: max(.75rem, env(safe-area-inset-bottom));
    }

    ul {
      width: 4.5rem;
      padding: .45rem;
    }

    .floating-contact-bar__action {
      min-height: 3.5rem;
    }

    .floating-contact-bar svg {
      width: 1.45rem;
      height: 1.45rem;
    }

    .floating-contact-bar__item:hover .floating-contact-bar__detail,
    .floating-contact-bar__item:focus-within .floating-contact-bar__detail {
      transform: translateY(-50%) translateX(0);
      opacity: 1;
      visibility: visible;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .floating-contact-bar,
    .floating-contact-bar__action,
    .floating-contact-bar__detail {
      transition: none;
    }
  }
</style>
