---
import ConfigurableForm from "../../inquiry/ConfigurableForm.astro";
import type { ConfigurableFormField } from "../../../inquiry/form-ui";
interface ContextItem { label: string; value: string; }
interface Props { id: string; title: string; description: string; steps: string[]; currentStep?: number; fields: ConfigurableFormField[]; submitLabel: string; formAction?: string; contextTitle: string; contextItems: ContextItem[]; secondaryTitle?: string; secondaryDescription?: string; secondaryAction?: { label: string; href: string }; }
const { id, title, description, steps, currentStep = 0, fields, submitLabel, formAction, contextTitle, contextItems, secondaryTitle, secondaryDescription, secondaryAction } = Astro.props;
---
<section id={id} class="guided-inquiry" aria-labelledby={`${id}-title`}>
  <header><p>Project inquiry</p><h2 id={`${id}-title`}>{title}</h2><div>{description}</div></header>
  <div class="guided-inquiry__grid">
    <div>
      <ol aria-label="Inquiry progress" style={`--step-count: ${steps.length}`}>{steps.map((step, index) => <li aria-current={index === currentStep ? "step" : undefined}><span>{String(index + 1).padStart(2, "0")}</span><small>{step}</small></li>)}</ol>
      <ConfigurableForm id={`${id}-form`} {fields} {submitLabel} {formAction} compact />
    </div>
    <aside><h3>{contextTitle}</h3><dl>{contextItems.map((item) => <div><dt>{item.label}</dt><dd>{item.value}</dd></div>)}</dl>{secondaryTitle && <div class="guided-inquiry__secondary"><h3>{secondaryTitle}</h3>{secondaryDescription && <p>{secondaryDescription}</p>}{secondaryAction && <a href={secondaryAction.href}>{secondaryAction.label} →</a>}</div>}</aside>
  </div>
</section>
<style>
  .guided-inquiry { padding: clamp(2rem, 7vw, 6rem); background: var(--ds-color-surface); }
  header { margin-bottom: 3rem; padding: clamp(2rem, 5vw, 4rem); background: var(--ds-color-ink); color: var(--ds-color-surface); text-align: center; }
  header p { margin: 0; color: var(--ds-color-accent-soft); font-size: .75rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
  h2 { margin: .5rem 0; font-size: clamp(2rem, 5vw, 4rem); }
  .guided-inquiry__grid { display: grid; gap: clamp(2rem, 6vw, 5rem); max-width: 72rem; margin: 0 auto; }
  ol { display: grid; grid-template-columns: repeat(var(--step-count, 3), 1fr); gap: .4rem; margin: 0 0 2rem; padding: 0; list-style: none; }
  ol li { display: grid; gap: .25rem; border-top: .25rem solid var(--ds-color-border); padding-top: .6rem; color: var(--ds-color-muted); }
  ol li[aria-current="step"] { border-color: var(--ds-color-accent); color: var(--ds-color-ink); }
  ol span { font-weight: 800; }
  aside h3 { margin: 0 0 1rem; }
  dl { display: grid; gap: 1rem; margin: 0; }
  dt { font-size: .75rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  dd { margin: .2rem 0 0; color: var(--ds-color-muted); }
  .guided-inquiry__secondary { margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--ds-color-border); }
  .guided-inquiry__secondary p { color: var(--ds-color-muted); }
  .guided-inquiry__secondary a { color: var(--ds-color-accent); font-weight: 800; }
  @media (min-width: 52rem) { .guided-inquiry__grid { grid-template-columns: minmax(0, 1.5fr) minmax(15rem, .7fr); } }
</style>
