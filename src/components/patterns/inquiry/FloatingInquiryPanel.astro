---
import ConfigurableForm from "../../inquiry/ConfigurableForm.astro";
import type { ConfigurableFormField } from "../../../inquiry/form-ui";
import type { ClientInquiryConfig } from "../../../inquiry/types";

export type FloatingInquiryField = {
  name: string;
  label: string;
  placeholder?: string;
  type?: "text" | "email" | "tel";
  autocomplete?: string;
  required?: boolean;
  rows?: number;
};

interface Props {
  id: string;
  title: string;
  description: string;
  triggerLabel: string;
  fields: FloatingInquiryField[];
  submitLabel: string;
  formAction?: string;
  inquiryConfig?: ClientInquiryConfig;
  deliveryNote?: string;
  defaultOpen?: boolean;
  preview?: boolean;
}

const {
  id,
  title,
  description,
  triggerLabel,
  fields,
  submitLabel,
  formAction,
  inquiryConfig,
  deliveryNote = "Connect a verified form endpoint before enabling delivery.",
  defaultOpen = false,
  preview = false,
} = Astro.props;

const dialogId = `${id}-dialog`;
const titleId = `${id}-title`;
const formId = `${id}-form`;
const resolvedFields = fields.map((field) => ({
  name: field.name,
  label: field.label,
  placeholder: field.placeholder,
  control: field.type ?? "text",
  autocomplete: field.autocomplete,
  required: field.required,
  rows: field.rows,
  span: field.rows ? "full" : "half",
  maxLength: field.name === "message" ? 4000 : field.name === "email" ? 254 : 240,
} satisfies ConfigurableFormField));
---

<aside class:list={["floating-inquiry", { "floating-inquiry--preview": preview }]} data-floating-inquiry>
  <dialog
    id={dialogId}
    class="floating-inquiry__dialog"
    aria-labelledby={titleId}
    data-floating-inquiry-dialog
    open={defaultOpen}
  >
    <header class="floating-inquiry__header">
      <h2 id={titleId}>{title}</h2>
      <button type="button" class="floating-inquiry__close" aria-label={`Close ${title}`} data-floating-inquiry-close>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
      </button>
    </header>

    <div class="floating-inquiry__body">
      <p>{description}</p>
      <ConfigurableForm
        id={formId}
        fields={resolvedFields}
        submitLabel={submitLabel}
        formAction={formAction}
        inquiryConfig={inquiryConfig}
        deliveryNote={deliveryNote}
        compact
      />
    </div>
  </dialog>

  <button
    type="button"
    class="floating-inquiry__trigger"
    aria-controls={dialogId}
    aria-expanded={defaultOpen}
    data-floating-inquiry-trigger
  >
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5.5h16v11H8l-4 3v-14Z" /><path d="M8 10h.01M12 10h.01M16 10h.01" /></svg>
    <span>{triggerLabel}</span>
  </button>
</aside>

<script>
  function initializeFloatingInquiryPanels() {
    document.querySelectorAll<HTMLElement>("[data-floating-inquiry]").forEach((root) => {
      if (root.dataset.ready === "true") return;
      root.dataset.ready = "true";
      const dialog = root.querySelector<HTMLDialogElement>("[data-floating-inquiry-dialog]");
      const trigger = root.querySelector<HTMLButtonElement>("[data-floating-inquiry-trigger]");
      const close = root.querySelector<HTMLButtonElement>("[data-floating-inquiry-close]");
      if (!dialog || !trigger || !close) return;

      const setExpanded = (expanded: boolean) => trigger.setAttribute("aria-expanded", String(expanded));
      trigger.addEventListener("click", () => {
        if (!dialog.open) dialog.show();
        setExpanded(true);
        close.focus();
      });
      close.addEventListener("click", () => dialog.close());
      dialog.addEventListener("keydown", (event) => {
        if (event.key !== "Escape" || !dialog.open) return;
        event.preventDefault();
        dialog.close();
      });
      dialog.addEventListener("close", () => {
        setExpanded(false);
        trigger.focus();
      });
    });
  }

  initializeFloatingInquiryPanels();
  document.addEventListener("astro:page-load", initializeFloatingInquiryPanels);
</script>

<style>
  .floating-inquiry { position: fixed; z-index: 60; right: clamp(.75rem, 2.5vw, 2rem); bottom: calc(clamp(.75rem, 2.5vw, 1.5rem) + var(--floating-inquiry-mobile-offset, 0px)); font-family: var(--ds-font-sans); }
  .floating-inquiry--preview { position: absolute; inset: 0; pointer-events: none; }
  .floating-inquiry--preview > * { pointer-events: auto; }
  .floating-inquiry__trigger { display: inline-flex; min-height: 3.5rem; align-items: center; justify-content: center; gap: .75rem; border: 0; border-radius: 999px; padding: .9rem 1.5rem; background: var(--ds-color-ink); box-shadow: 0 .75rem 2rem rgb(10 16 35 / .2); color: var(--ds-color-surface); font: inherit; font-weight: 800; cursor: pointer; }
  .floating-inquiry__trigger svg { width: 1.5rem; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.8; }
  .floating-inquiry__dialog { position: fixed; z-index: 61; inset: auto clamp(.75rem, 2.5vw, 2rem) calc(6rem + var(--floating-inquiry-mobile-offset, 0px)) auto; width: min(27rem, calc(100vw - 1.5rem)); max-height: min(42rem, calc(100dvh - 7rem - var(--floating-inquiry-mobile-offset, 0px))); margin: 0; overflow: hidden; border: 0; border-radius: 1rem; padding: 0; background: var(--ds-color-surface); box-shadow: 0 1.5rem 4rem rgb(10 16 35 / .24); color: var(--ds-color-ink); text-align: left; }
  .floating-inquiry--preview .floating-inquiry__dialog { position: absolute; inset: 1.25rem 1.25rem 6rem auto; max-height: calc(100% - 8.25rem); }
  .floating-inquiry--preview .floating-inquiry__trigger { position: absolute; right: 1.25rem; bottom: 1.25rem; }
  .floating-inquiry__header { display: flex; min-height: 4rem; align-items: center; justify-content: space-between; gap: 1rem; padding: 1rem 1.25rem; background: var(--ds-color-accent); color: var(--ds-color-accent-contrast); }
  .floating-inquiry__header h2 { margin: 0; font-size: 1.15rem; line-height: 1.3; }
  .floating-inquiry__close { display: grid; width: 2.75rem; height: 2.75rem; flex: 0 0 auto; place-items: center; border: 0; border-radius: 999px; padding: 0; background: transparent; color: currentColor; cursor: pointer; }
  .floating-inquiry__close:hover { background: rgb(255 255 255 / .12); }
  .floating-inquiry__close svg { width: 1.35rem; fill: none; stroke: currentColor; stroke-linecap: round; stroke-width: 1.8; }
  .floating-inquiry__body { max-height: calc(min(42rem, 100dvh - 7rem - var(--floating-inquiry-mobile-offset, 0px)) - 4rem); overflow-y: auto; padding: 1.25rem; scrollbar-color: color-mix(in oklch, var(--ds-color-muted), transparent 35%) transparent; scrollbar-width: thin; }
  .floating-inquiry__body > p { margin: 0 0 1rem; color: var(--ds-color-muted); line-height: 1.55; }
  form { display: grid; gap: 1rem; }
  label { display: grid; gap: .4rem; color: var(--ds-color-ink); font-size: .8rem; font-weight: 750; }
  label strong { color: var(--ds-color-accent); }
  input, textarea { width: 100%; border: 1px solid var(--ds-color-border); border-radius: .55rem; padding: .75rem .9rem; background: var(--ds-color-surface); color: var(--ds-color-ink); font: inherit; font-weight: 400; }
  textarea { min-height: 7rem; resize: vertical; }
  input::placeholder, textarea::placeholder { color: color-mix(in oklch, var(--ds-color-muted), transparent 15%); }
  @media (max-width: 35rem) {
    .floating-inquiry { right: .5rem; bottom: calc(.5rem + var(--floating-inquiry-mobile-offset, 0px)); left: .5rem; text-align: right; }
    .floating-inquiry__trigger { min-height: 3.25rem; padding: .8rem 1.15rem; }
    .floating-inquiry__dialog { inset: auto .5rem calc(4.75rem + var(--floating-inquiry-mobile-offset, 0px)); width: calc(100vw - 1rem); max-height: calc(100dvh - 5.5rem - var(--floating-inquiry-mobile-offset, 0px)); }
    .floating-inquiry--preview .floating-inquiry__dialog { inset: .5rem .5rem 5rem; width: auto; max-height: calc(100% - 5.5rem); text-align: left; }
    .floating-inquiry--preview .floating-inquiry__trigger { right: .5rem; bottom: .5rem; }
    .floating-inquiry__body { max-height: calc(100dvh - 9.5rem - var(--floating-inquiry-mobile-offset, 0px)); }
  }
</style>
