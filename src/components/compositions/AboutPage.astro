---
import type { AboutPageContent } from "../../content-models/sections";
import AboutAdvantages from "../sections/AboutAdvantages.astro";
import AboutCompanyCarousel from "../sections/AboutCompanyCarousel.astro";
import AboutCompanyInformation from "../sections/AboutCompanyInformation.astro";
import AboutImageGallery from "../sections/AboutImageGallery.astro";
import AboutRecommendation from "../sections/AboutRecommendation.astro";

interface Props {
  content: AboutPageContent;
  class?: string;
}

const { content, class: className } = Astro.props;
---

<div class:list={["about-page", className]}>
  <AboutCompanyInformation id="about-company" {...content.company} />
  <AboutRecommendation id="about-recommendation" {...content.recommendation} />
  <AboutAdvantages id="about-advantages" {...content.advantages} />
  <AboutImageGallery id="about-gallery" {...content.gallery} />
  <AboutCompanyCarousel id="about-carousel" {...content.carousel} />
</div>
