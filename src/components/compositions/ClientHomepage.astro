---
import type { ClientSiteConfig } from "../../config/schema";
import { hasBlockingConfigIssues, validateClientSiteConfig } from "../../config/validate";
import ArcFactoryHero from "../patterns/hero/ArcFactoryHero.astro";
import CenteredProofHero from "../patterns/hero/CenteredProofHero.astro";
import RecognitionBackdropHero from "../patterns/hero/RecognitionBackdropHero.astro";
import ProductCategoryList from "../patterns/products/ProductCategoryList.astro";
import ProductMosaic from "../patterns/products/ProductMosaic.astro";
import ProofColumns from "../patterns/evidence/ProofColumns.astro";
import HorizontalProcess from "../patterns/process/HorizontalProcess.astro";
import ProcessCards from "../patterns/process/ProcessCards.astro";
import SplitPathways from "../patterns/pathways/SplitPathways.astro";
import FacilityGallery from "../patterns/facility/FacilityGallery.astro";
import QualityEvidenceMatrix from "../patterns/quality/QualityEvidenceMatrix.astro";
import SplitInquiry from "../patterns/inquiry/SplitInquiry.astro";
import FloatingTrustBar from "../patterns/proof/FloatingTrustBar.astro";
import StatementHero from "../sections/StatementHero.astro";
import ProductFamilies from "../sections/ProductFamilies.astro";
import EvidenceFeature from "../sections/EvidenceFeature.astro";
import BuyerPathways from "../sections/BuyerPathways.astro";
import QualityFramework from "../sections/QualityFramework.astro";
import ProcessSteps from "../sections/ProcessSteps.astro";
import FacilityOverview from "../sections/FacilityOverview.astro";
import InquiryCTA from "../sections/InquiryCTA.astro";
import SiteHeader from "../sections/SiteHeader.astro";
import SiteFooter from "../sections/SiteFooter.astro";

interface Props { config: ClientSiteConfig; }

const { config } = Astro.props;
const issues = validateClientSiteConfig(config);
if (hasBlockingConfigIssues(issues)) {
  throw new Error(`Invalid client configuration: ${issues.filter((issue) => issue.severity === "error").map((issue) => `${issue.path}: ${issue.message}`).join("; ")}`);
}

const heroPatterns = {
  "StatementHero-001": StatementHero,
  "CenteredProofHero-001": CenteredProofHero,
  "ArcFactoryHero-001": ArcFactoryHero,
};
const productPatterns = {
  "ProductFamilies-001": ProductFamilies,
  "ProductMosaic-001": ProductMosaic,
  "ProductCategoryList-001": ProductCategoryList,
};
const evidencePatterns = {
  "EvidenceFeature-001": EvidenceFeature,
  "ProofColumns-001": ProofColumns,
};
const pathwayPatterns = {
  "BuyerPathways-001": BuyerPathways,
  "SplitPathways-001": SplitPathways,
};
const qualityPatterns = {
  "QualityFramework-001": QualityFramework,
  "QualityEvidenceMatrix-001": QualityEvidenceMatrix,
};
const processPatterns = {
  "ProcessSteps-001": ProcessSteps,
  "HorizontalProcess-001": HorizontalProcess,
  "ProcessCards-001": ProcessCards,
};
const facilityPatterns = {
  "FacilityOverview-001": FacilityOverview,
  "FacilityGallery-001": FacilityGallery,
};
const inquiryPatterns = {
  "InquiryCTA-001": InquiryCTA,
  "SplitInquiry-001": SplitInquiry,
};

const standardHeroId = config.patterns.hero as keyof typeof heroPatterns;
const HeroPattern = heroPatterns[standardHeroId];
const ProductPattern = productPatterns[config.patterns.products];
const EvidencePattern = evidencePatterns[config.patterns.evidence];
const PathwayPattern = pathwayPatterns[config.patterns.pathways];
const QualityPattern = qualityPatterns[config.patterns.quality];
const ProcessPattern = processPatterns[config.patterns.process];
const FacilityPattern = facilityPatterns[config.patterns.facility];
const InquiryPattern = inquiryPatterns[config.patterns.inquiry];
const trustEnabled = config.optionalPatterns.floatingTrustBar.status === "enabled" && config.optionalContent.floatingTrustBar;
const navigation = [
  { href: config.routes.home, label: "Home" },
  { href: config.routes.products, label: "Products" },
  { href: config.routes.capabilities, label: "Capabilities" },
  { href: config.routes.about, label: "About" },
  { href: config.routes.contact, label: "Contact" },
] as const;
const patternSummary = Object.values(config.patterns);
const warningCount = issues.filter((issue) => issue.severity === "warning").length;
const { colors } = config.theme;
---

<div class="client-site">
  <a class="skip-link" href="#main-content">Skip to main content</a>
  {config.mode === "review" && (
    <aside class="configuration-review" aria-label="Client configuration review status">
      <div>
        <p><strong>护肤品客户网站示例，仅供 UI 与内容结构审核</strong> · {warningCount} 项客户事实待核验</p>
        <details>
          <summary>查看审核信息</summary>
          <div class="configuration-review__details">
            <div><h2>当前使用的 UI 零件</h2><ul>{patternSummary.map((pattern) => <li>{pattern}</li>)}</ul></div>
            <div><h2>正式上线前待客户核验</h2><ul>{issues.map((issue) => <li><strong>{issue.path}</strong>: {issue.message}</li>)}</ul></div>
          </div>
        </details>
      </div>
    </aside>
  )}

  <SiteHeader
    brand={config.identity.displayName.value}
    homeHref={config.routes.home}
    {navigation}
    currentPath={config.routes.home}
    utilityText="Facial skincare · Body care · Private label development"
    inquiryAction={{ href: config.routes.contact, label: config.contact.inquiryLabel }}
  />

  <main id="main-content">
    {"slides" in config.homepage.hero
      ? <RecognitionBackdropHero {...config.homepage.hero} id="hero" />
      : <HeroPattern {...config.homepage.hero} id="hero" />}
    {trustEnabled && <FloatingTrustBar {...config.optionalContent.floatingTrustBar!} id="trust" />}
    <PathwayPattern {...config.homepage.pathways} id="pathways" />
    <div id="products"><ProductPattern {...config.homepage.products} id="products-pattern" /></div>
    <div id="evidence"><EvidencePattern {...config.homepage.evidence} id="evidence-pattern" /></div>
    <div id="quality"><QualityPattern {...config.homepage.quality} id="quality-pattern" /></div>
    <div id="process"><ProcessPattern {...config.homepage.process} id="process-pattern" /></div>
    <div id="facility"><FacilityPattern {...config.homepage.facility} id="facility-pattern" /></div>
    <div id="inquiry"><InquiryPattern {...config.homepage.inquiry} id="inquiry-pattern" /></div>
  </main>

  <SiteFooter
    brand={config.identity.displayName.value}
    description={config.identity.summary.value}
    linkGroups={[{ title: "Explore", links: navigation }]}
    contactActions={[{ href: config.routes.contact, label: config.contact.inquiryLabel }]}
    copyrightLabel="Illustrative skincare manufacturer website. Replace all demo identity, capability, evidence, and contact data before publication."
  />
</div>

<style define:vars={{
  clientCanvas: colors.canvas,
  clientSurface: colors.surface,
  clientSurfaceSubtle: colors.surfaceSubtle,
  clientInk: colors.ink,
  clientMuted: colors.muted,
  clientAccent: colors.accent,
  clientAccentContrast: colors.accentContrast,
  clientBorder: colors.border,
}}>
  .client-site {
    --ds-color-canvas: var(--clientCanvas);
    --ds-color-surface: var(--clientSurface);
    --ds-color-ink: var(--clientInk);
    --ds-color-muted: var(--clientMuted);
    --ds-color-accent: var(--clientAccent);
    --ds-color-accent-contrast: var(--clientAccentContrast);
    --ds-color-border: var(--clientBorder);
    --color-canvas: var(--clientCanvas);
    --color-surface: var(--clientSurface);
    --color-surface-subtle: var(--clientSurfaceSubtle);
    --color-ink: var(--clientInk);
    --color-text-muted: var(--clientMuted);
    --color-accent: var(--clientAccent);
    --color-on-accent: var(--clientAccentContrast);
    --color-on-ink: var(--clientCanvas);
    --color-border: var(--clientBorder);
    --color-border-strong: color-mix(in oklch, var(--clientBorder), var(--clientInk) 20%);
    min-height: 100vh;
    background: var(--clientCanvas);
    color: var(--clientInk);
  }
  .configuration-review { padding: .75rem var(--ds-page-gutter); background: #fff4c7; color: #2d2500; font-size: .875rem; }
  .configuration-review > div { width: min(100%, var(--ds-container-wide)); margin-inline: auto; }
  .configuration-review p { margin: 0; }
  .configuration-review summary { width: fit-content; margin-top: .35rem; font-weight: 700; cursor: pointer; }
  .configuration-review__details { display: grid; gap: 1rem 2rem; margin-top: 1rem; border-top: 1px solid rgb(45 37 0 / .2); padding-top: 1rem; }
  .configuration-review h2 { margin: 0; font-size: .875rem; }
  .configuration-review ul { margin: .5rem 0 0; padding-left: 1.25rem; }
  .skip-link { position: fixed; z-index: 100; top: .5rem; left: .5rem; padding: .75rem 1rem; background: var(--clientInk); color: var(--clientCanvas); transform: translateY(-200%); }
  .skip-link:focus { transform: translateY(0); }
  main > div { scroll-margin-top: 1rem; }
  @media (min-width: 48rem) { .configuration-review__details { grid-template-columns: .7fr 1.3fr; } }
</style>
