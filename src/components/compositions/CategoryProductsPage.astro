---
import type { ComponentProps } from "astro/types";
import CategoryProductGrid from "../sections/CategoryProductGrid.astro";
import PageIntro from "../sections/PageIntro.astro";

interface Props {
  intro: ComponentProps<typeof PageIntro>;
  products: ComponentProps<typeof CategoryProductGrid>;
  class?: string;
}
const { intro, products, class: className } = Astro.props;
---
<div class:list={["category-products-page", className]}>
  <PageIntro {...intro} />
  <CategoryProductGrid {...products} />
</div>
