---
import type { ComponentProps } from "astro/types";

import PageIntro from "../sections/PageIntro.astro";
import ProductFamilies from "../sections/ProductFamilies.astro";

interface Props {
  intro?: ComponentProps<typeof PageIntro>;
  products: ComponentProps<typeof ProductFamilies>;
  class?: string;
}

const { intro, products, class: className } = Astro.props;
---

<div class:list={["products-page", className]}>
  {intro && <PageIntro {...intro} />}
  <ProductFamilies {...products} headingLevel="h1" />
</div>
