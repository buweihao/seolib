---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  level?: "h2" | "h3";
  align?: "start" | "center";
  id?: string;
  class?: string;
}

const {
  eyebrow,
  title,
  description,
  level = "h2",
  align = "start",
  id,
  class: className,
} = Astro.props;

const Heading = level;
---

<header class:list={["section-heading", className]} data-align={align}>
  {eyebrow && <p class="section-heading__eyebrow">{eyebrow}</p>}
  <Heading id={id} class="section-heading__title">{title}</Heading>
  {description && <p class="section-heading__description">{description}</p>}
</header>

<style>
  .section-heading {
    max-width: var(--ds-container-reading);
  }

  .section-heading[data-align="center"] {
    margin-inline: auto;
    text-align: center;
  }

  .section-heading__eyebrow {
    margin: 0 0 var(--ds-space-3);
    color: var(--ds-color-accent);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .section-heading__title {
    margin: 0;
    font-size: clamp(1.875rem, 4vw, 3.25rem);
    line-height: 1.1;
  }

  .section-heading__description {
    max-width: 62ch;
    margin: var(--ds-space-4) 0 0;
    color: var(--ds-color-muted);
    font-size: clamp(1rem, 1.4vw, 1.125rem);
  }

  .section-heading[data-align="center"] .section-heading__description {
    margin-inline: auto;
  }
</style>
