---
import "../styles/global.css";
import { serializeJsonLd } from "../seo/jsonld";
import type { SeoPageConfig } from "../seo/types";

interface Props {
  title?: string;
  description?: string;
  lang?: string;
  canonical?: string;
  image?: string;
  noindex?: boolean;
  seo?: SeoPageConfig;
}

const {
  title: legacyTitle,
  description: legacyDescription,
  lang = "en",
  canonical: legacyCanonical,
  image: legacyImage,
  noindex: legacyNoindex = false,
  seo,
} = Astro.props;

const title = seo?.title ?? legacyTitle ?? "Untitled page";
const description = seo?.description ?? legacyDescription ?? "";
const noindex = seo?.noindex ?? legacyNoindex;
const nofollow = seo?.nofollow ?? noindex;
const baseUrl = Astro.site ?? Astro.url.origin;
const absoluteUrl = (value: string | undefined) => value ? new URL(value, baseUrl).href : undefined;
const canonical = absoluteUrl(seo?.canonical ?? legacyCanonical ?? (!noindex && Astro.site ? Astro.url.pathname : undefined));
const image = absoluteUrl(seo?.image ?? legacyImage);
const alternates = seo?.alternates?.map((item) => ({ ...item, href: absoluteUrl(item.href)! })) ?? [];
const xDefault = absoluteUrl(seo?.xDefault);
const jsonLd = seo?.jsonLd ? serializeJsonLd(seo.jsonLd) : undefined;
---

<!doctype html>
<html lang={seo?.locale ?? lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="robots" content={`${noindex ? "noindex" : "index"}, ${nofollow ? "nofollow" : "follow"}`} />
    {canonical && <link rel="canonical" href={canonical} />}
    {alternates.map((item) => <link rel="alternate" hreflang={item.lang} href={item.href} />)}
    {xDefault && <link rel="alternate" hreflang="x-default" href={xDefault} />}
    <meta property="og:type" content={seo?.type === "article" ? "article" : seo?.type === "product" ? "product" : "website"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {seo?.siteName && <meta property="og:site_name" content={seo.siteName} />}
    {seo?.locale && <meta property="og:locale" content={seo.locale} />}
    {canonical && <meta property="og:url" content={canonical} />}
    {image && <meta property="og:image" content={image} />}
    {image && seo?.imageAlt && <meta property="og:image:alt" content={seo.imageAlt} />}
    <meta name="twitter:card" content={seo?.twitterCard ?? (image ? "summary_large_image" : "summary")} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {image && <meta name="twitter:image" content={image} />}
    {image && seo?.imageAlt && <meta name="twitter:image:alt" content={seo.imageAlt} />}
    {seo?.type === "article" && seo.publishedAt && <meta property="article:published_time" content={seo.publishedAt} />}
    {seo?.type === "article" && seo.updatedAt && <meta property="article:modified_time" content={seo.updatedAt} />}
    {seo?.type === "article" && seo.author && <meta property="article:author" content={seo.author} />}
    {jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd}></script>}
    <title>{title}</title>
  </head>
  <body class="bg-canvas text-ink antialiased">
    <slot />
    {noindex && Astro.url.pathname !== "/" && (
      <a class="review-hub-link" href="/" aria-label="返回网站审核总导航">总导航</a>
    )}
  </body>
</html>

<style is:global>
  .review-hub-link {
    position: fixed;
    z-index: 90;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: .65rem 1rem;
    border: 1px solid color-mix(in oklch, var(--ds-color-canvas), transparent 72%);
    border-radius: 999px;
    background: color-mix(in oklch, var(--ds-color-ink), transparent 8%);
    box-shadow: 0 .6rem 1.6rem color-mix(in oklch, black, transparent 82%);
    color: var(--ds-color-canvas);
    font-size: .875rem;
    font-weight: 750;
    line-height: 1;
    text-decoration: none;
    backdrop-filter: blur(.5rem);
  }
  .review-hub-link:hover { background: var(--ds-color-accent); color: var(--ds-color-accent-contrast); }
</style>
