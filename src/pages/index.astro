---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="B2B Skincare Website Library"
  description="The design foundation for a reusable B2B skincare manufacturer website library."
>
  <main class="mx-auto flex min-h-screen max-w-content items-center px-(--ds-page-gutter) py-section-compact">
    <div class="max-w-reading">
      <p class="mb-4 text-sm font-semibold tracking-[0.12em] text-muted uppercase">Phase 1</p>
      <h1 class="text-[length:var(--ds-text-display)] leading-[var(--ds-leading-display)] font-semibold">
        Design foundation
      </h1>
      <p class="mt-6 max-w-[62ch] text-lg text-muted">
        The static Astro foundation, shared design-token contract, and library directories are ready for
        reference-led component work.
      </p>
    </div>
  </main>
</BaseLayout>
