---
import PatternReview from "../../../components/patterns/PatternReview.astro";
import CenteredProofHero from "../../../components/patterns/hero/CenteredProofHero.astro";
import RecognitionBackdropHero from "../../../components/patterns/hero/RecognitionBackdropHero.astro";
import ArcFactoryHero from "../../../components/patterns/hero/ArcFactoryHero.astro";
import { arcFactoryHero, recognitionHero } from "../../../fixtures/referencePatterns";
import ProductCategoryList from "../../../components/patterns/products/ProductCategoryList.astro";
import ProductMosaic from "../../../components/patterns/products/ProductMosaic.astro";
import ProofColumns from "../../../components/patterns/evidence/ProofColumns.astro";
import HorizontalProcess from "../../../components/patterns/process/HorizontalProcess.astro";
import ProcessCards from "../../../components/patterns/process/ProcessCards.astro";
import SplitPathways from "../../../components/patterns/pathways/SplitPathways.astro";
import FacilityGallery from "../../../components/patterns/facility/FacilityGallery.astro";
import QualityEvidenceMatrix from "../../../components/patterns/quality/QualityEvidenceMatrix.astro";
import SplitInquiry from "../../../components/patterns/inquiry/SplitInquiry.astro";
import BuyerPathways from "../../../components/sections/BuyerPathways.astro";
import EvidenceFeature from "../../../components/sections/EvidenceFeature.astro";
import FacilityOverview from "../../../components/sections/FacilityOverview.astro";
import InquiryCTA from "../../../components/sections/InquiryCTA.astro";
import ProcessSteps from "../../../components/sections/ProcessSteps.astro";
import ProductFamilies from "../../../components/sections/ProductFamilies.astro";
import QualityFramework from "../../../components/sections/QualityFramework.astro";
import StatementHero from "../../../components/sections/StatementHero.astro";
import { aboutPage, capabilitiesPage, homePage, productsPage } from "../../../fixtures/baseSite";
import PatternLibraryLayout from "../../../layouts/PatternLibraryLayout.astro";

const hero = { ...homePage.hero, proofItems: homePage.proof.items.map((item) => item.title) };
const shared = { contentEvidence: "来自 Phase 7 的可读示例内容模型；内容本身不由参考网站决定。", uiEvidence: "通用网页布局规律，经多个参考案例交叉验证；不复制任何单站品牌或成品设计。" };
---

<PatternLibraryLayout title="UI 模式审核台" description="这里故意让同一份内容依次进入不同 UI 模式。先判断信息是否正确，再判断展示方式是否适合客户，最后才选择页面组合。">
  <div class="pattern-stack">
    <section class="group" id="heroes"><h2>Hero patterns</h2><p>保留经过审核、结构差异足够明显的 Hero。</p></section>
    <PatternReview patternId="StatementHero-001" name="Statement split" suitableFor="品牌主张清楚、需要文案与主视觉并重的首页" {...shared} originalTreatment="克制的双栏结构、原创间距与按钮层级。"><StatementHero {...hero} id="demo-hero-statement" headingLevel="h3" /></PatternReview>
    <PatternReview patternId="CenteredProofHero-001" name="Centered proof" suitableFor="需要在首屏快速建立信任的供应商" {...shared} originalTreatment="居中叙事后连接证明条，不采用特定站点外观。"><CenteredProofHero {...hero} id="demo-hero-centered" headingLevel="h3" /></PatternReview>
    <PatternReview patternId="ArcFactoryHero-001" name="Arc factory panorama" suitableFor="需要用工厂全景和采购主张共同开场的制造商" contentEvidence="工厂媒体及所有商业、质量表述均须由客户提供并核验。" uiEvidence="Laeyo 02 Hero：宽阔文案区、工厂全景，以及连接两者的大型弧形切口。" originalTreatment="使用原创弧形几何、配色、响应式重排、文案和审核素材，不复用来源图片或标识。"><ArcFactoryHero {...arcFactoryHero} id="demo-hero-arc-factory" headingLevel="h3" /></PatternReview>
    <PatternReview patternId="RecognitionBackdropHero-001" name="Recognition collage" suitableFor="拥有真实奖项、媒体、成果或案例证明的企业" contentEvidence="奖项、媒体、产品成果和案例由客户提供并核验。" uiEvidence="Vitelle 02 Hero 的交错证明卡、认可徽章、中央标题条和底部定位语句关系。" originalTreatment="使用原创审核图、原创拼贴角度、徽章和响应式重排。"><RecognitionBackdropHero {...recognitionHero} id="demo-hero-recognition" headingLevel="h3" /></PatternReview>

    <section class="group" id="products"><h2>Product patterns</h2><p>同一产品分类内容，3 种展示方式。</p></section>
    <PatternReview patternId="ProductFamilies-001" name="Equal cards" suitableFor="分类权重相近、需要快速浏览" {...shared} originalTreatment="等权卡片网格。"><ProductFamilies {...productsPage.products} id="demo-products-cards" /></PatternReview>
    <PatternReview patternId="ProductMosaic-001" name="Image mosaic" suitableFor="图片成熟、希望强化产品氛围" {...shared} originalTreatment="用原创拼贴节奏区分重点分类。"><ProductMosaic {...productsPage.products} id="demo-products-mosaic" /></PatternReview>
    <PatternReview patternId="ProductCategoryList-001" name="Category list" suitableFor="分类较多、采购者需要高效扫描" {...shared} originalTreatment="编号目录配小图，强调信息效率。"><ProductCategoryList {...productsPage.products} id="demo-products-list" /></PatternReview>

    <section class="group" id="evidence"><h2>Evidence patterns</h2><p>同一证据内容，2 种展示方式。</p></section>
    <PatternReview patternId="EvidenceFeature-001" name="Media split" suitableFor="需要用一张主图解释证明体系" {...shared} originalTreatment="媒体与证据清单并列。"><EvidenceFeature {...homePage.evidence} id="demo-evidence-media" /></PatternReview>
    <PatternReview patternId="ProofColumns-001" name="Proof columns" suitableFor="没有合适主图、希望直接比较证据点" {...shared} originalTreatment="以编号证据列替代装饰图。"><ProofColumns {...homePage.evidence} id="demo-evidence-columns" /></PatternReview>

    <section class="group" id="process"><h2>Process patterns</h2><p>同一流程内容，3 种展示方式。</p></section>
    <PatternReview patternId="ProcessSteps-001" name="Vertical responsibilities" suitableFor="步骤复杂、需要写清双方责任" {...shared} originalTreatment="纵向步骤兼容责任说明。"><ProcessSteps {...capabilitiesPage.process} id="demo-process-vertical" /></PatternReview>
    <PatternReview patternId="HorizontalProcess-001" name="Horizontal timeline" suitableFor="步骤少且顺序明确" {...shared} originalTreatment="桌面横向、移动端纵向的语义有序列表。"><HorizontalProcess {...capabilitiesPage.process} id="demo-process-horizontal" /></PatternReview>
    <PatternReview patternId="ProcessCards-001" name="Process cards" suitableFor="每个阶段需独立解释" {...shared} originalTreatment="深色模块化阶段卡片。"><ProcessCards {...capabilitiesPage.process} id="demo-process-cards" /></PatternReview>

    <section class="group" id="pathways"><h2>Pathway patterns</h2><p>同一合作路线内容，2 种展示方式。</p></section>
    <PatternReview patternId="BuyerPathways-001" name="Route cards" suitableFor="三种以上合作模式并列比较" {...shared} originalTreatment="等权决策卡。"><BuyerPathways {...homePage.pathways} id="demo-pathways-cards" /></PatternReview>
    <PatternReview patternId="SplitPathways-001" name="Split routes" suitableFor="两种核心方向需要强对比" {...shared} originalTreatment="交替明暗分区形成决策对照。"><SplitPathways {...homePage.pathways} id="demo-pathways-split" /></PatternReview>

    <section class="group" id="facility"><h2>Facility patterns</h2><p>同一设施内容，2 种展示方式。</p></section>
    <PatternReview patternId="FacilityOverview-001" name="Facility overview" suitableFor="一张总览图配清单" {...shared} originalTreatment="总览媒体与核验说明并列。"><FacilityOverview {...aboutPage.facility} id="demo-facility-overview" /></PatternReview>
    <PatternReview patternId="FacilityGallery-001" name="Facility gallery" suitableFor="工厂视觉较强、区域需要模块化说明" {...shared} originalTreatment="大幅总览媒体后接区域信息墙。"><FacilityGallery {...aboutPage.facility} id="demo-facility-gallery" /></PatternReview>

    <section class="group" id="quality"><h2>Quality patterns</h2><p>同一质量内容，2 种展示方式。</p></section>
    <PatternReview patternId="QualityFramework-001" name="Quality checkpoints" suitableFor="循序解释质量节点" {...shared} originalTreatment="检查点与证据类型成组。"><QualityFramework {...capabilitiesPage.quality} id="demo-quality-checkpoints" /></PatternReview>
    <PatternReview patternId="QualityEvidenceMatrix-001" name="Evidence matrix" suitableFor="采购人员需要快速核验" {...shared} originalTreatment="表格式扫描结构但保留语义文章元素。"><QualityEvidenceMatrix {...capabilitiesPage.quality} id="demo-quality-matrix" /></PatternReview>

    <section class="group" id="inquiry"><h2>Inquiry patterns</h2><p>同一询盘内容，2 种展示方式。</p></section>
    <PatternReview patternId="InquiryCTA-001" name="Dark inquiry" suitableFor="页面末端的强收口" {...shared} originalTreatment="深色集中式行动区。"><InquiryCTA {...productsPage.inquiry} id="demo-inquiry-dark" /></PatternReview>
    <PatternReview patternId="SplitInquiry-001" name="Split inquiry" suitableFor="需要同时说明准备材料与行动" {...shared} originalTreatment="标题与询盘准备项分栏。"><SplitInquiry {...productsPage.inquiry} id="demo-inquiry-split" /></PatternReview>
  </div>
</PatternLibraryLayout>

<style>
  .pattern-stack { width: min(100% - 2 * var(--ds-page-gutter), 100rem); margin: 0 auto; padding-bottom: var(--ds-section-feature); }
  .group { scroll-margin-top: 1rem; margin: var(--ds-section-feature) 0 var(--ds-space-8); }
  .group:first-child { margin-top: 0; }
  .group h2, .group p { margin: 0; }
  .group h2 { font-size: clamp(2rem, 4vw, 3rem); }
  .group p { margin-top: var(--ds-space-2); color: var(--ds-color-muted); }
</style>
