---
import AboutPage from "../../../../components/compositions/AboutPage.astro";
import CompanyFactMatrix from "../../../../components/sections/CompanyFactMatrix.astro";
import PageResourceRail from "../../../../components/sections/PageResourceRail.astro";
import { procurementEvidenceClient } from "../../../../config/clients/procurement-evidence";
import ClientPageShell from "../../../../layouts/ClientPageShell.astro";
---

<ClientPageShell
  config={procurementEvidenceClient}
  currentPath={procurementEvidenceClient.routes.about}
  title="About and facility evidence | Procurement evidence client preview"
  description="Review-only company, facility, and evidence page for the typed skincare manufacturer client configuration."
>
  <AboutPage {...procurementEvidenceClient.pages.about} />
  <CompanyFactMatrix
    id="about-facts"
    eyebrow="Verification frame"
    title="Start with the facts that still need an owner"
    description="This neutral matrix keeps company, facility, and market information configurable until the client supplies records for review."
    facts={[
      { label: "Evidence status", value: "Pending client verification", detail: "Attach the source record before publication." },
      { label: "R&D scope", value: "Configure from verified records", detail: "Separate capability language from unverified claims." },
      { label: "Manufacturing scope", value: "Set by project brief", detail: "Confirm the relevant process and responsibility." },
      { label: "Markets", value: "Configure by destination", detail: "Keep regulatory and language needs explicit." },
    ]}
  />
  <PageResourceRail
    id="about-resources"
    title="Continue the evidence review"
    description="Move from company context to the specific product, capability, and inquiry questions that still need verification."
    resources={[
      { label: "Product catalogue", href: procurementEvidenceClient.routes.products, detail: "Review category and detail routes" },
      { label: "Capability scope", href: procurementEvidenceClient.routes.capabilities, detail: "Review responsibilities and process" },
      { label: "Start an inquiry", href: procurementEvidenceClient.routes.contact, detail: "Prepare the next project brief" },
    ]}
  />
</ClientPageShell>
