# Canonical production origin used by Astro and sitemap generation.
SITE_URL=https://www.example.com

# Sanity product catalogue and embedded Studio at /admin.
# These values are public identifiers, not secrets.
PUBLIC_SANITY_PROJECT_ID=your-project-id
PUBLIC_SANITY_DATASET=production
PUBLIC_SANITY_API_VERSION=2026-08-01

# Public inquiry delivery. Configure these in the hosting provider; never commit real values.
# These build-time values activate the client form only after a real privacy notice is published.
PUBLIC_INQUIRY_DELIVERY=resend
PUBLIC_INQUIRY_ALLOWED_ORIGINS=https://www.example.com,https://example.com
PUBLIC_INQUIRY_PRIVACY_POLICY_URL=/privacy/
PUBLIC_INQUIRY_PRIVACY_POLICY_VERSION=2026-08-24

# These runtime values are read only by the Cloudflare Function.
RESEND_API_KEY=re_xxxxxxxxx
INQUIRY_TO_EMAIL=sales@example.com
INQUIRY_FROM_EMAIL=Website Inquiry <inquiry@send.example.com>
INQUIRY_ALLOWED_ORIGINS=https://www.example.com,https://example.com

# On Cloudflare Pages, add a dashboard rate-limiting rule for POST /api/inquiry.
# INQUIRY_RATE_LIMITER remains an optional binding when this Function is reused in a Worker.
